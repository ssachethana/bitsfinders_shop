model User {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(120)
  // Case-insensitive uniqueness is added in db_constraints.sql (lower(email)).
  email           String       @unique @db.VarChar(254)
  passwordHash    String?      @db.VarChar(255)
  status          UserStatus   @default(ACTIVE)
  platformRole    PlatformRole @default(USER)
  language        String       @default("en") @db.VarChar(10)
  imageUrl        String?      @db.VarChar(2048)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  ownedShops          Shop[]                   @relation("ShopOwner")
  memberships         ShopMember[]
  sessions            Session[]
  emailTokens         EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaMethods          MfaMethod[]
  recoveryCodes       RecoveryCode[]
  expenses            Expense[]                @relation("ExpenseCreator")
  priceChanges        ProductPriceHistory[]    @relation("PriceChangedBy")
  reports             ProfitReport[]           @relation("ReportGenerator")
  recordedLosses      InventoryLoss[]          @relation("LossRecorder")
  createdApiKeys      ApiKey[]                 @relation("ApiKeyCreator")
  auditLogs           AuditLog[]               @relation("AuditActor")
  securityEvents      SecurityEvent[]          @relation("SecurityEventUser")
  cashMovements       CashMovement[]           @relation("CashMovementCreator")
  sentInvites         ShopInvite[]             @relation("InviteSender")
  notifications       Notification[]

  // v4
  approvedDiscounts SaleDiscountLine[] @relation("DiscountApprover")

  @@index([status])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  deviceName String?   @db.VarChar(120)
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(128)
  familyId  String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId, expiresAt])
  @@index([familyId])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model MfaMethod {
  id              String    @id @default(cuid())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            MfaType
  // Encrypt TOTP/WebAuthn secret material with a managed key; never store plaintext.
  secretEncrypted String?   @db.Text
  credentialId    String?   @unique @db.VarChar(512)
  isEnabled       Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, isEnabled])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @db.VarChar(128)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// -----------------------------------------------------------------------------
// TENANT / SHOP / RBAC
// -----------------------------------------------------------------------------

model Shop {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(180)
  currency  String    @default("USD") @db.VarChar(3)
  timezone  String    @default("UTC") @db.VarChar(64)
  location  String?   @db.VarChar(255)
  isActive  Boolean   @default(true)
  // Shops are soft-deleted. Financial tables use onDelete: Restrict, so a shop that
  // has any trading history can never be hard-deleted by accident.
  deletedAt DateTime?
  ownerId   Int
  owner     User      @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members                 ShopMember[]
  employeeProfiles        EmployeeProfile[]
  workShiftTemplates      WorkShiftTemplate[]
  workSchedules           WorkSchedule[]
  workAssignments         WorkShiftAssignment[]
  attendanceRecords       AttendanceRecord[]
  leaveRequests           EmployeeLeaveRequest[]
  payrollPeriods          PayrollPeriod[]
  payrolls                Payroll[]
  salaryAdvances          SalaryAdvance[]
  roles                   Role[]
  settings                ShopSettings?
  terminals               Terminal[]
  cashShifts              CashShift[]
  taxRates                TaxRate[]
  receiptSequences        ReceiptSequence[]
  invites                 ShopInvite[]
  subscription            Subscription?
  products                Product[]
  batches                 PurchaseBatch[]
  purchases               Purchase[]
  purchaseReturns         PurchaseReturn[]
  supplierPayments        SupplierPayment[]
  stocktakes              Stocktake[]
  promotions              Promotion[]
  sales                   Sale[]
  returns                 Return[]
  expenses                Expense[]
  expenseCategories       ExpenseCategory[]
  profitReports           ProfitReport[]
  dailySummaries          DailySalesSummary[]
  losses                  InventoryLoss[]
  customers               Customer[]
  suppliers               Supplier[]
  brands                  Brand[]
  categories              LocalCategory[]
  inventoryMovements      InventoryMovement[]
  inventoryLocations      InventoryLocation[]
  warehouses              Warehouse[]
  warehouseTransfers      WarehouseTransfer[]
  locationStockLevels     LocationStockLevel[]
  locationBatchStocks     LocationBatchStock[]
  warehouseTransferItems  WarehouseTransferItem[]
  productSpecifications   ProductSpecification[]
  websiteCategories       WebsiteCategory[]
  websiteHomepageSections WebsiteHomepageSection[]
  websiteSlugRedirects    WebsiteSlugRedirect[]
  websiteVariantListings  WebsiteVariantListing[]
  websiteListings         WebsiteListing[]
  website                 ShopWebsite?
  websiteDomains          WebsiteDomain[]
  websitePages            WebsitePage[]
  websiteBanners          WebsiteBanner[]
  websiteSocialLinks      WebsiteSocialLink[]
  websiteProductMedia     WebsiteProductMedia[]
  carts                   Cart[]
  wishlists               Wishlist[]
  productReviews          ProductReview[]
  customerAddresses       CustomerAddress[]
  customerAccounts        CustomerAccount[]
  coupons                 Coupon[]
  couponRedemptions       CouponRedemption[]
  shippingZones           ShippingZone[]
  shippingMethods         ShippingMethod[]
  orderHistory            OrderStatusHistory[]
  paymentWebhookEvents    PaymentWebhookEvent[]
  marketplaceListings     MarketplaceListing[]
  orders                  Order[]
  orderNotes              OrderNote[]
  apiKeys                 ApiKey[]
  notifications           Notification[]
  conversations           Conversation[]
  conversationMembers     ConversationMember[]
  chatMessages            ChatMessage[]
  chatAttachments         ChatAttachment[]
  conversationEvents      ConversationEvent[]
  auditLogs               AuditLog[]
  securityEvents          SecurityEvent[]
  // v4: a transfer belongs to BOTH shops (sender and receiver).
  outgoingTransfers       StockTransfer[]          @relation("TransferFromShop")
  incomingTransfers       StockTransfer[]          @relation("TransferToShop")

  @@index([ownerId])
  @@index([isActive, deletedAt])
}

// Receipt / printer / tax / behaviour settings of a shop (1:1).
model ShopSettings {
  id                           Int      @id @default(autoincrement())
  shopId                       Int      @unique
  legalName                    String?  @db.VarChar(180)
  address                      String?  @db.VarChar(500)
  phone                        String?  @db.VarChar(40)
  email                        String?  @db.VarChar(254)
  logoUrl                      String?  @db.VarChar(2048)
  taxRegistrationNumber        String?  @db.VarChar(60)
  receiptHeader                String?  @db.VarChar(500)
  receiptFooter                String?  @db.VarChar(500)
  paperWidthMm                 Int      @default(80)
  printerConfig                Json?
  // true  => product prices already include tax; false => tax is added on top.
  pricesIncludeTax             Boolean  @default(false)
  // 0 = no rounding, 0.05 / 1 / 10 ... = round the sale total to this increment.
  roundingIncrement            Decimal  @default(0) @db.Decimal(10, 4)
  // false => the DB refuses a movement that would take StockLevel.onHand below 0.
  allowNegativeStock           Boolean  @default(false)
  // true => a sale needs an OPEN cash shift on its terminal.
  requireShiftForSale          Boolean  @default(true)
  // Manual discounts above this % need a manager (enforced in the service layer). 0 = none allowed.
  maxCashierDiscountPercent    Decimal  @default(0) @db.Decimal(5, 2)
  // Loyalty: points earned per 1 unit of currency spent, and currency value of 1 point.
  loyaltyPointsPerCurrencyUnit Decimal  @default(0) @db.Decimal(10, 4)
  loyaltyPointValue            Decimal  @default(0) @db.Decimal(10, 4)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// A till / register / device = the CASH REGISTER.
// Sales, shifts (cash sessions) and receipt sequences can be per terminal.
model Terminal {
  id                  Int       @id @default(autoincrement())
  shopId              Int
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(80)
  isActive            Boolean   @default(true)
  // v4: suggested float when a cashier opens a shift on this register.
  defaultOpeningFloat Decimal   @default(0) @db.Decimal(19, 4)
  // v4: printer / cash-drawer / scanner / customer-display settings of this device.
  hardwareConfig      Json?
  lastSeenAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  shop   Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shifts CashShift[]
  sales  Sale[]

  @@unique([shopId, code])
  @@unique([id, shopId])
}

model ShopMember {
  id             Int              @id @default(autoincrement())
  shopId         Int
  userId         Int
  status         MembershipStatus @default(INVITED)
  // Quick cashier PIN (store a slow hash, e.g. argon2id). Lets a till switch user without full login.
  pinHash        String?          @db.VarChar(255)
  pinFailedCount Int              @default(0)
  pinLockedUntil DateTime?
  invitedAt      DateTime         @default(now())
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  shop                        Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles                       MemberRole[]
  employeeProfile             EmployeeProfile?
  createdWorkShifts           WorkShiftAssignment[]         @relation("ShiftAssignedBy")
  attendanceMarked            AttendanceRecord[]            @relation("AttendanceMarkedBy")
  attendanceApproved          AttendanceRecord[]            @relation("AttendanceApprovedBy")
  leaveDecisions              EmployeeLeaveRequest[]        @relation("LeaveDecidedBy")
  generatedPayrolls           Payroll[]                     @relation("PayrollGeneratedBy")
  approvedPayrolls            Payroll[]                     @relation("PayrollApprovedBy")
  recordedPayrollPays         PayrollPayment[]              @relation("PayrollPaymentRecorder")
  approvedAdvances            SalaryAdvance[]               @relation("AdvanceApprovedBy")
  compensationChanges         EmployeeCompensationHistory[] @relation("CompensationChangedBy")
  conversationMemberships     ConversationMember[]
  assignedConversations       Conversation[]                @relation("ConversationAssignee")
  sentChatMessages            ChatMessage[]                 @relation("StaffChatSender")
  messageReadReceipts         MessageReadReceipt[]          @relation("StaffMessageRead")
  conversationEvents          ConversationEvent[]           @relation("StaffConversationEventActor")
  // Inventory / purchasing actors are tied to a membership, not merely a global User.
  inventoryMovements          InventoryMovement[]           @relation("MovementActor")
  purchases                   Purchase[]                    @relation("PurchaseCreator")
  purchaseReturns             PurchaseReturn[]              @relation("PurchaseReturnCreator")
  supplierPayments            SupplierPayment[]             @relation("SupplierPaymentCreator")
  supplierLedgerEntries       SupplierLedgerEntry[]         @relation("SupplierLedgerActor")
  stocktakes                  Stocktake[]                   @relation("StocktakeCreator")
  createdStockTransfers       StockTransfer[]               @relation("TransferCreator")
  receivedStockTransfers      StockTransfer[]               @relation("TransferReceiver")
  warehouseTransfersRequested WarehouseTransfer[]           @relation("WarehouseTransferRequester")
  warehouseTransfersApproved  WarehouseTransfer[]           @relation("WarehouseTransferApprover")
  warehouseTransfersShipped   WarehouseTransfer[]           @relation("WarehouseTransferShipper")
  warehouseTransfersReceived  WarehouseTransfer[]           @relation("WarehouseTransferReceiver")
  // POS actors are tenant memberships, not global users: composite (shopId,userId) FKs.
  posSales                    Sale[]                        @relation("SaleCashier")
  voidedSaleItems             SaleItem[]                    @relation("SaleItemVoider")
  customerCreditEntries       CustomerCreditEntry[]         @relation("CustomerCreditActor")
  voidedSales                 Sale[]                        @relation("SaleVoider")
  receivedSalePayments        SalePayment[]                 @relation("SalePaymentReceiver")
  receivedCustomerPayments    CustomerPayment[]             @relation("CustomerPaymentReceiver")
  processedReturns            Return[]                      @relation("ReturnProcessor")
  processedRefundPayments     SaleRefundPayment[]           @relation("RefundPaymentProcessor")
  openedShifts                CashShift[]                   @relation("ShiftOpener")
  closedShifts                CashShift[]                   @relation("ShiftCloser")
  approvedShiftDifferences    CashShift[]                   @relation("ShiftDifferenceApprover")

  @@unique([shopId, userId])
  // Compound target enables tenant-safe MemberRole relations.
  @@unique([id, shopId])
  @@index([userId, status])
}

model ShopInvite {
  id          String    @id @default(cuid())
  shopId      Int
  email       String    @db.VarChar(254)
  roleId      Int
  invitedById Int
  tokenHash   String    @unique @db.VarChar(128)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Tenant-safe: the invited role must belong to this shop.
  role      Role @relation(fields: [roleId, shopId], references: [id, shopId], onDelete: Cascade)
  invitedBy User @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([shopId, email])
  @@index([expiresAt])
}

model Role {
  id          Int      @id @default(autoincrement())
  shopId      Int
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MemberRole[]
  invites     ShopInvite[]

  @@unique([shopId, name])
  @@unique([id, shopId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MemberRole {
  memberId   Int
  roleId     Int
  shopId     Int
  assignedAt DateTime @default(now())

  member ShopMember @relation(fields: [memberId, shopId], references: [id, shopId], onDelete: Cascade)
  role   Role       @relation(fields: [roleId, shopId], references: [id, shopId], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([shopId, roleId])
}

model ApiKey {
  id          String    @id @default(cuid())
  shopId      Int
  createdById Int
  name        String    @db.VarChar(100)
  keyPrefix   String    @db.VarChar(16)
  keyHash     String    @unique @db.VarChar(128)
  scopes      String[]  @default([])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  shop      Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdBy User @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shopId, revokedAt])
  @@index([createdById])
}

// -----------------------------------------------------------------------------
// EMPLOYEES / WORK SCHEDULES / ATTENDANCE / PAYROLL
// -----------------------------------------------------------------------------

// A ShopMember is the login + permission identity. EmployeeProfile adds HR data.
// This lets an owner invite a worker first, then complete the employment profile.
model EmployeeProfile {
  id                    Int            @id @default(autoincrement())
  shopId                Int
  memberId              Int?
  employeeNumber        String         @db.VarChar(40)
  phone                 String?        @db.VarChar(40)
  address               String?        @db.VarChar(500)
  jobTitle              String?        @db.VarChar(100)
  department            String?        @db.VarChar(100)
  employmentType        EmploymentType @default(FULL_TIME)
  payType               PayType        @default(MONTHLY)
  baseSalary            Decimal        @default(0) @db.Decimal(19, 4)
  hourlyRate            Decimal?       @db.Decimal(19, 4)
  dailyRate             Decimal?       @db.Decimal(19, 4)
  overtimeMultiplier    Decimal        @default(1.5) @db.Decimal(6, 3)
  standardHoursPerDay   Decimal        @default(8) @db.Decimal(6, 2)
  standardHoursPerWeek  Decimal        @default(40) @db.Decimal(7, 2)
  hireDate              DateTime       @db.Date
  endDate               DateTime?      @db.Date
  isActive              Boolean        @default(true)
  emergencyContactName  String?        @db.VarChar(120)
  emergencyContactPhone String?        @db.VarChar(40)
  note                  String?        @db.VarChar(1000)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Tenant-safe: employee profile must belong to this shop membership.
  shop                Shop                          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  // Optional login account: employees can be managed even when they do not use the app.
  // Same-shop membership is enforced by employee_payroll_constraints.sql trigger.
  member              ShopMember?                   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  compensationHistory EmployeeCompensationHistory[]
  workSchedules       WorkSchedule[]
  workAssignments     WorkShiftAssignment[]
  attendance          AttendanceRecord[]
  leaveRequests       EmployeeLeaveRequest[]
  payrolls            Payroll[]
  salaryAdvances      SalaryAdvance[]

  @@unique([shopId, employeeNumber])
  @@unique([memberId])
  @@unique([id, shopId])
  @@index([shopId, isActive, hireDate])
  @@index([shopId, department])
}

// Immutable salary/rate history. Update EmployeeProfile's current rate and insert
// a history row in the same transaction whenever compensation changes.
model EmployeeCompensationHistory {
  id                 Int       @id @default(autoincrement())
  shopId             Int
  employeeId         Int
  payType            PayType
  baseSalary         Decimal   @default(0) @db.Decimal(19, 4)
  hourlyRate         Decimal?  @db.Decimal(19, 4)
  dailyRate          Decimal?  @db.Decimal(19, 4)
  overtimeMultiplier Decimal   @default(1.5) @db.Decimal(6, 3)
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  reason             String?   @db.VarChar(500)
  changedByMemberId  Int?
  createdAt          DateTime  @default(now())

  employee  EmployeeProfile @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  changedBy ShopMember?     @relation("CompensationChangedBy", fields: [changedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([id, shopId])
  @@index([shopId, employeeId, effectiveFrom])
}

// Reusable named shift definition, e.g. Morning 08:00-16:00 or Night 22:00-06:00.
// Times are local wall-clock strings in HH:mm; overnight shifts set isOvernight=true.
model WorkShiftTemplate {
  id                 Int      @id @default(autoincrement())
  shopId             Int
  name               String   @db.VarChar(100)
  startTime          String   @db.VarChar(5)
  endTime            String   @db.VarChar(5)
  breakMinutes       Int      @default(0)
  gracePeriodMinutes Int      @default(5)
  isOvernight        Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop         Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scheduleDays WorkScheduleDay[]
  assignments  WorkShiftAssignment[]

  @@unique([shopId, name])
  @@unique([id, shopId])
  @@index([shopId, isActive])
}

// A recurring weekly schedule for an employee, with effective dates.
model WorkSchedule {
  id            Int       @id @default(autoincrement())
  shopId        Int
  employeeId    Int
  name          String    @db.VarChar(100)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // v4 FIX: Shop.workSchedules had no opposite relation field (Prisma validation error).
  shop        Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee    EmployeeProfile       @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  days        WorkScheduleDay[]
  assignments WorkShiftAssignment[]

  @@unique([id, shopId])
  @@index([shopId, employeeId, isActive])
  @@index([shopId, effectiveFrom, effectiveTo])
}

model WorkScheduleDay {
  id              Int           @id @default(autoincrement())
  shopId          Int
  scheduleId      Int
  dayOfWeek       WorkDayOfWeek
  isWorkingDay    Boolean       @default(true)
  shiftTemplateId Int?
  startTime       String?       @db.VarChar(5)
  endTime         String?       @db.VarChar(5)
  breakMinutes    Int           @default(0)

  schedule WorkSchedule       @relation(fields: [scheduleId, shopId], references: [id, shopId], onDelete: Cascade)
  shift    WorkShiftTemplate? @relation(fields: [shiftTemplateId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([scheduleId, dayOfWeek])
  @@index([shopId, shiftTemplateId])
}

// A dated roster entry. Create one even for an unscheduled/ad-hoc shift so every
// AttendanceRecord has an auditable planned-work reference.
model WorkShiftAssignment {
  id                 Int      @id @default(autoincrement())
  shopId             Int
  employeeId         Int
  scheduleId         Int?
  shiftTemplateId    Int?
  workDate           DateTime @db.Date
  plannedStartAt     DateTime
  plannedEndAt       DateTime
  breakMinutes       Int      @default(0)
  note               String?  @db.VarChar(500)
  assignedByMemberId Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop       Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee   EmployeeProfile    @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  schedule   WorkSchedule?      @relation(fields: [scheduleId, shopId], references: [id, shopId], onDelete: Restrict)
  shift      WorkShiftTemplate? @relation(fields: [shiftTemplateId, shopId], references: [id, shopId], onDelete: Restrict)
  assignedBy ShopMember         @relation("ShiftAssignedBy", fields: [assignedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  attendance AttendanceRecord?

  @@unique([id, employeeId, shopId])
  @@index([shopId, workDate, employeeId])
  @@index([employeeId, workDate])
}

// One attendance row per roster assignment. For a missing worker, the system can
// create an ABSENT row after the shop's configured grace/closing time.
model AttendanceRecord {
  id                 Int              @id @default(autoincrement())
  shopId             Int
  employeeId         Int
  assignmentId       Int              @unique
  status             AttendanceStatus @default(PRESENT)
  scheduledStartAt   DateTime
  scheduledEndAt     DateTime
  checkInAt          DateTime?
  checkOutAt         DateTime?
  breakMinutes       Int              @default(0)
  workedMinutes      Int              @default(0)
  lateMinutes        Int              @default(0)
  earlyLeaveMinutes  Int              @default(0)
  overtimeMinutes    Int              @default(0)
  note               String?          @db.VarChar(500)
  markedByMemberId   Int?
  approvedByMemberId Int?
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  shop       Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee   EmployeeProfile     @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  assignment WorkShiftAssignment @relation(fields: [assignmentId, employeeId, shopId], references: [id, employeeId, shopId], onDelete: Restrict)
  markedBy   ShopMember?         @relation("AttendanceMarkedBy", fields: [markedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  approvedBy ShopMember?         @relation("AttendanceApprovedBy", fields: [approvedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([id, shopId])
  @@unique([assignmentId, employeeId, shopId])
  @@index([shopId, status, scheduledStartAt])
  @@index([shopId, employeeId, scheduledStartAt])
}

model EmployeeLeaveRequest {
  id                Int                @id @default(autoincrement())
  shopId            Int
  employeeId        Int
  leaveType         String             @db.VarChar(60)
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  requestedDays     Decimal            @db.Decimal(6, 2)
  reason            String?            @db.VarChar(1000)
  status            LeaveRequestStatus @default(PENDING)
  decidedByMemberId Int?
  decidedAt         DateTime?
  decisionNote      String?            @db.VarChar(500)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee  EmployeeProfile @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  decidedBy ShopMember?     @relation("LeaveDecidedBy", fields: [decidedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([id, shopId])
  @@index([shopId, status, startDate])
  @@index([employeeId, startDate, endDate])
}

model PayrollPeriod {
  id          Int                 @id @default(autoincrement())
  shopId      Int
  name        String              @db.VarChar(80)
  periodStart DateTime            @db.Date
  periodEnd   DateTime            @db.Date
  status      PayrollPeriodStatus @default(OPEN)
  processedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  payrolls Payroll[]

  @@unique([shopId, periodStart, periodEnd])
  @@unique([id, shopId])
  @@index([shopId, status, periodStart])
}

// Payroll is a frozen calculation snapshot. Re-running attendance later must not
// silently alter an approved/paid payslip. Generate inside a transaction.
model Payroll {
  id                  Int           @id @default(autoincrement())
  shopId              Int
  periodId            Int
  employeeId          Int
  currency            String        @db.VarChar(3)
  payTypeSnapshot     PayType
  baseSalarySnapshot  Decimal       @default(0) @db.Decimal(19, 4)
  hourlyRateSnapshot  Decimal?      @db.Decimal(19, 4)
  dailyRateSnapshot   Decimal?      @db.Decimal(19, 4)
  overtimeMultiplier  Decimal       @default(1.5) @db.Decimal(6, 3)
  regularHours        Decimal       @default(0) @db.Decimal(9, 2)
  overtimeHours       Decimal       @default(0) @db.Decimal(9, 2)
  paidLeaveDays       Decimal       @default(0) @db.Decimal(7, 2)
  unpaidLeaveDays     Decimal       @default(0) @db.Decimal(7, 2)
  grossEarnings       Decimal       @default(0) @db.Decimal(19, 4)
  totalDeductions     Decimal       @default(0) @db.Decimal(19, 4)
  netPay              Decimal       @default(0) @db.Decimal(19, 4)
  amountPaid          Decimal       @default(0) @db.Decimal(19, 4)
  status              PayrollStatus @default(DRAFT)
  calculationSnapshot Json?
  generatedByMemberId Int
  approvedByMemberId  Int?
  generatedAt         DateTime      @default(now())
  approvedAt          DateTime?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  shop        Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  period      PayrollPeriod    @relation(fields: [periodId, shopId], references: [id, shopId], onDelete: Restrict)
  employee    EmployeeProfile  @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  generatedBy ShopMember       @relation("PayrollGeneratedBy", fields: [generatedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  approvedBy  ShopMember?      @relation("PayrollApprovedBy", fields: [approvedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  lines       PayrollLine[]
  payments    PayrollPayment[]

  @@unique([periodId, employeeId])
  @@unique([id, shopId])
  @@index([shopId, status, generatedAt])
  @@index([employeeId, periodId])
}

// Every earning/deduction is explicit: overtime, bonus, allowance, tax, EPF/ETF,
// unpaid leave, advance repayment, etc. Use a code to keep reporting consistent.
model PayrollLine {
  id              Int             @id @default(autoincrement())
  shopId          Int
  payrollId       Int
  salaryAdvanceId Int?
  type            PayrollLineType
  code            String          @db.VarChar(50)
  description     String          @db.VarChar(180)
  quantity        Decimal?        @db.Decimal(12, 3)
  rate            Decimal?        @db.Decimal(19, 4)
  amount          Decimal         @db.Decimal(19, 4)
  isTaxable       Boolean         @default(true)
  createdAt       DateTime        @default(now())

  payroll       Payroll        @relation(fields: [payrollId, shopId], references: [id, shopId], onDelete: Restrict)
  salaryAdvance SalaryAdvance? @relation(fields: [salaryAdvanceId, shopId], references: [id, shopId], onDelete: Restrict)

  @@index([payrollId, type])
  @@index([shopId, code])
}

model PayrollPayment {
  id                 Int           @id @default(autoincrement())
  shopId             Int
  payrollId          Int
  method             PaymentMethod @default(CASH)
  amount             Decimal       @db.Decimal(19, 4)
  reference          String?       @db.VarChar(120)
  note               String?       @db.VarChar(500)
  paidAt             DateTime      @default(now())
  recordedByMemberId Int
  createdAt          DateTime      @default(now())

  payroll    Payroll    @relation(fields: [payrollId, shopId], references: [id, shopId], onDelete: Restrict)
  recordedBy ShopMember @relation("PayrollPaymentRecorder", fields: [recordedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)

  @@index([shopId, paidAt])
  @@index([payrollId])
}

model SalaryAdvance {
  id                 Int                 @id @default(autoincrement())
  shopId             Int
  employeeId         Int
  requestedAmount    Decimal             @db.Decimal(19, 4)
  approvedAmount     Decimal?            @db.Decimal(19, 4)
  repaidAmount       Decimal             @default(0) @db.Decimal(19, 4)
  status             SalaryAdvanceStatus @default(REQUESTED)
  reason             String?             @db.VarChar(500)
  requestedAt        DateTime            @default(now())
  approvedByMemberId Int?
  approvedAt         DateTime?
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  employee       EmployeeProfile @relation(fields: [employeeId, shopId], references: [id, shopId], onDelete: Restrict)
  approvedBy     ShopMember?     @relation("AdvanceApprovedBy", fields: [approvedByMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  repaymentLines PayrollLine[]

  @@unique([id, shopId])
  @@index([shopId, status, requestedAt])
  @@index([employeeId, requestedAt])
}

// -----------------------------------------------------------------------------
// PLATFORM BILLING (SaaS plans)
// -----------------------------------------------------------------------------

model Plan {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(80)
  priceMonthly Decimal  @db.Decimal(19, 4)
  priceYearly  Decimal? @db.Decimal(19, 4)
  currency     String   @default("USD") @db.VarChar(3)
  // e.g. { "maxTerminals": 3, "maxProducts": 5000, "maxStaff": 10 }
  limits       Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  shopId                 Int                @unique
  planId                 Int
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  canceledAt             DateTime?
  provider               String?            @db.VarChar(60)
  providerSubscriptionId String?            @db.VarChar(160)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, currentPeriodEnd])
}

// v6 adds customer support and internal staff messaging.
// -----------------------------------------------------------------------------
// MESSAGING — customer ↔ shop staff, and private staff ↔ staff conversations
// -----------------------------------------------------------------------------
// CUSTOMER_SUPPORT conversations have exactly one shop Customer as the customer-side
// identity; staff participants are rows in ConversationMember. STAFF_INTERNAL
// conversations have no customer and are visible only to active shop members added
// to ConversationMember. All links include shopId to prevent cross-tenant references.

model Conversation {
  id               String               @id @default(cuid())
  shopId           Int
  type             ConversationType
  customerId       Int?
  subject          String?              @db.VarChar(180)
  status           ConversationStatus   @default(OPEN)
  priority         ConversationPriority @default(NORMAL)
  assignedMemberId Int?
  lastMessageAt    DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  shop        Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer    Customer?            @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  assignee    ShopMember?          @relation("ConversationAssignee", fields: [assignedMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  members     ConversationMember[]
  messages    ChatMessage[]
  attachments ChatAttachment[]
  events      ConversationEvent[]

  @@unique([id, shopId])
  @@index([shopId, type, status, lastMessageAt])
  @@index([shopId, customerId, updatedAt])
  @@index([shopId, assignedMemberId, status])
}

model ConversationMember {
  id             String                 @id @default(cuid())
  shopId         Int
  conversationId String
  memberId       Int
  
  addedAt        DateTime               @default(now())
  lastReadAt     DateTime?
  mutedAt        DateTime?

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, shopId], references: [id, shopId], onDelete: Cascade)
  member       ShopMember   @relation(fields: [memberId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([conversationId, memberId])
  @@unique([id, shopId])
  @@index([shopId, memberId, lastReadAt])
}

model ChatMessage {
  id               String          @id @default(cuid())
  shopId           Int
  conversationId   String
  senderType       ChatSenderType
  senderCustomerId Int?
  senderMemberId   Int?
  messageType      ChatMessageType @default(TEXT)
  body             String?         @db.Text
  replyToMessageId String?
  clientMessageId  String?         @db.VarChar(100)
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())

  shop           Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId, shopId], references: [id, shopId], onDelete: Cascade)
  senderCustomer Customer?            @relation("CustomerChatSender", fields: [senderCustomerId, shopId], references: [id, shopId], onDelete: Restrict)
  senderMember   ShopMember?          @relation("StaffChatSender", fields: [senderMemberId, shopId], references: [id, shopId], onDelete: Restrict)
  replyTo        ChatMessage?         @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]        @relation("ChatMessageReplies")
  attachments    ChatAttachment[]
  readReceipts   MessageReadReceipt[]

  @@unique([id, shopId])
  @@unique([shopId, conversationId, clientMessageId])
  @@index([shopId, conversationId, createdAt])
  @@index([shopId, senderMemberId, createdAt])
  @@index([shopId, senderCustomerId, createdAt])
}

model ChatAttachment {
  id             String   @id @default(cuid())
  shopId         Int
  conversationId String
  messageId      String
  storageKey     String   @db.VarChar(512)
  originalName   String   @db.VarChar(255)
  mimeType       String   @db.VarChar(120)
  sizeBytes      BigInt
  checksumSha256 String?  @db.VarChar(64)
  createdAt      DateTime @default(now())

  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId, shopId], references: [id, shopId], onDelete: Cascade)
  message      ChatMessage  @relation(fields: [messageId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@index([shopId, conversationId, createdAt])
  @@index([messageId])
}

model MessageReadReceipt {
  id         String         @id @default(cuid())
  shopId     Int
  messageId  String
  readerType ChatSenderType
  customerId Int?
  memberId   Int?
  readAt     DateTime       @default(now())

  message  ChatMessage @relation(fields: [messageId, shopId], references: [id, shopId], onDelete: Cascade)
  customer Customer?   @relation("CustomerMessageRead", fields: [customerId, shopId], references: [id, shopId], onDelete: Cascade)
  member   ShopMember? @relation("StaffMessageRead", fields: [memberId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@unique([messageId, customerId])
  @@unique([messageId, memberId])
  @@index([shopId, readAt])
}

model ConversationEvent {
  id              String                @id @default(cuid())
  shopId          Int
  conversationId  String
  actorType       ChatSenderType
  actorCustomerId Int?
  actorMemberId   Int?
  eventType       ConversationEventType
  data            Json?
  createdAt       DateTime              @default(now())

  shop          Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversation  Conversation @relation(fields: [conversationId, shopId], references: [id, shopId], onDelete: Cascade)
  actorCustomer Customer?    @relation("CustomerConversationEventActor", fields: [actorCustomerId, shopId], references: [id, shopId], onDelete: Restrict)
  actorMember   ShopMember?  @relation("StaffConversationEventActor", fields: [actorMemberId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([id, shopId])
  @@index([shopId, conversationId, createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  shopId    Int
  // null = visible to every member allowed to see this type.
  userId    Int?
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?          @db.VarChar(1000)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  shop Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId, readAt, createdAt])
  @@index([userId, readAt])
}

// -----------------------------------------------------------------------------
// TAX / NUMBERING
// -----------------------------------------------------------------------------

model TaxRate {
  id          Int      @id @default(autoincrement())
  shopId      Int
  name        String   @db.VarChar(60)
  code        String?  @db.VarChar(20)
  ratePercent Decimal  @db.Decimal(7, 4)
  // One default per shop — partial unique index in db_constraints.sql.
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products      Product[]
  saleItems     SaleItem[]
  saleTaxLines  SaleTaxLine[]
  purchaseItems PurchaseItem[]

  @@unique([shopId, name])
  @@unique([id, shopId])
}

// Gap-free, race-safe counters. Inside the sale transaction run:
//   UPDATE "ReceiptSequence" SET "nextNumber" = "nextNumber" + 1
//   WHERE "shopId" = $1 AND "key" = $2 RETURNING "nextNumber" - 1;
// key examples: "SALE", "SALE:<terminalId>", "RETURN", "ORDER", "PURCHASE",
//               "TRANSFER", "CUSTOMER_PAYMENT", "SUPPLIER_PAYMENT".
model ReceiptSequence {
  id         Int      @id @default(autoincrement())
  shopId     Int
  key        String   @db.VarChar(40)
  prefix     String   @default("") @db.VarChar(20)
  padding    Int      @default(6)
  nextNumber BigInt   @default(1)
  updatedAt  DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
}

// -----------------------------------------------------------------------------
// CATEGORIES
// GlobalCategory = BitShop's standard marketplace taxonomy.
// LocalCategory = shop's own private category tree (optionally mapped to a global one).
// -----------------------------------------------------------------------------

model GlobalCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.VarChar(500)
  imageUrl    String?  @db.VarChar(2048)
  parentId    Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent          GlobalCategory?  @relation("GlobalCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        GlobalCategory[] @relation("GlobalCategoryTree")
  localCategories LocalCategory[]
  products        Product[]
  globalProducts  GlobalProduct[]

  @@index([parentId, sortOrder])
  @@index([isActive])
}

model LocalCategory {
  id               Int      @id @default(autoincrement())
  shopId           Int
  name             String   @db.VarChar(120)
  slug             String   @db.VarChar(140)
  description      String?  @db.VarChar(500)
  imageUrl         String?  @db.VarChar(2048)
  parentId         Int?
  globalCategoryId Int?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent         LocalCategory?  @relation("LocalCategoryTree", fields: [parentId, shopId], references: [id, shopId], onDelete: Restrict)
  children       LocalCategory[] @relation("LocalCategoryTree")
  globalCategory GlobalCategory? @relation(fields: [globalCategoryId], references: [id], onDelete: SetNull)
  products       Product[]
  promotions     Promotion[]

  @@unique([shopId, slug])
  @@unique([id, shopId])
  @@index([shopId, parentId, sortOrder])
  @@index([globalCategoryId])
}

// -----------------------------------------------------------------------------
// CATALOG
// -----------------------------------------------------------------------------

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  symbol    String   @unique @db.VarChar(16)
  createdAt DateTime @default(now())

  products        Product[]
  globalProducts  GlobalProduct[]
  conversionsFrom UnitConversion[] @relation("ConversionFrom")
  conversionsTo   UnitConversion[] @relation("ConversionTo")
}

// 1 fromUnit = factor x toUnit   (e.g. kg -> g : 1000).
// Carton -> piece is handled per variant with ProductBarcode.unitQuantity.
model UnitConversion {
  id         Int     @id @default(autoincrement())
  fromUnitId Int
  toUnitId   Int
  factor     Decimal @db.Decimal(18, 6)

  fromUnit Unit @relation("ConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   Unit @relation("ConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
}

model Brand {
  id        Int      @id @default(autoincrement())
  shopId    Int
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]

  @@unique([shopId, name])
  @@unique([id, shopId])
}

// Platform-wide brand used by the global catalog. Shops copy it into their own Brand.
model GlobalBrand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  logoUrl   String?  @db.VarChar(2048)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products GlobalProduct[]
}

// Product = shared catalog info. Price, SKU, barcodes and stock live on the variant.
model Product {
  id                  Int             @id @default(autoincrement())
  shopId              Int
  name                String          @db.VarChar(180)
  slug                String          @db.VarChar(200)
  description         String?         @db.Text
  imageUrl            String?         @db.VarChar(2048)
  reminder            Boolean         @default(false)
  brandId             Int?
  localCategoryId     Int?
  globalCategoryId    Int?
  taxRateId           Int?
  // Set when the shop adopted this product from the global catalog.
  globalProductId     Int?
  unitId              Int
  valuationMethod     ValuationMethod @default(FIFO)
  // false = simple product (single default variant), true = option-based variants
  hasVariants         Boolean         @default(false)
  isActive            Boolean         @default(true)
  displayProductInApp Boolean         @default(true)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  shop                 Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // Tenant-safe optional links. RESTRICT preserves shopId and requires explicit reassignment/archive.
  brand                Brand?                   @relation(fields: [brandId, shopId], references: [id, shopId], onDelete: Restrict)
  localCategory        LocalCategory?           @relation(fields: [localCategoryId, shopId], references: [id, shopId], onDelete: Restrict)
  taxRate              TaxRate?                 @relation(fields: [taxRateId, shopId], references: [id, shopId], onDelete: Restrict)
  globalCategory       GlobalCategory?          @relation(fields: [globalCategoryId], references: [id], onDelete: SetNull)
  globalProduct        GlobalProduct?           @relation(fields: [globalProductId], references: [id], onDelete: SetNull)
  unit                 Unit                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  options              ProductOption[]
  variants             ProductVariant[]
  specifications       ProductSpecification[]
  websiteCategoryLinks WebsiteProductCategory[]
  saleItems            SaleItem[]
  promotions           Promotion[]
  websiteListing       WebsiteListing?
  marketplaceListing   MarketplaceListing?
  orderItems           OrderItem[]
  websiteMedia         WebsiteProductMedia[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  reviews              ProductReview[]
  couponProducts       CouponProduct[]
  // pg_trgm GIN index on name — see db_constraints.sql.

  @@unique([shopId, slug])
  // A shop adopts each global product at most once (NULLs are allowed many times).
  @@unique([shopId, globalProductId])
  @@unique([id, shopId])
  @@index([shopId, name])
  @@index([shopId, isActive])
  @@index([globalCategoryId])
  @@index([globalProductId])
  @@index([shopId, localCategoryId])
  @@index([shopId, brandId])
  @@index([shopId, taxRateId])
}

// -----------------------------------------------------------------------------
// GLOBAL CATALOG (platform-owned, shared by every shop; no price / stock / cost)
// A shop "adopts" a GlobalProduct by copying it into its own Product/ProductVariant.
// -----------------------------------------------------------------------------

model GlobalProduct {
  id               Int                 @id @default(autoincrement())
  name             String              @db.VarChar(180)
  slug             String              @unique @db.VarChar(200)
  description      String?             @db.Text
  imageUrl         String?             @db.VarChar(2048)
  globalBrandId    Int?
  globalCategoryId Int?
  unitId           Int
  hasVariants      Boolean             @default(false)
  status           GlobalProductStatus @default(DRAFT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  brand        GlobalBrand?           @relation(fields: [globalBrandId], references: [id], onDelete: SetNull)
  category     GlobalCategory?        @relation(fields: [globalCategoryId], references: [id], onDelete: SetNull)
  unit         Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  options      GlobalProductOption[]
  variants     GlobalProductVariant[]
  shopProducts Product[]

  @@index([status, name])
  @@index([globalCategoryId])
  @@index([globalBrandId])
}

model GlobalProductOption {
  id              Int      @id @default(autoincrement())
  globalProductId Int
  name            String   @db.VarChar(60)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  globalProduct GlobalProduct              @relation(fields: [globalProductId], references: [id], onDelete: Cascade)
  values        GlobalProductOptionValue[]
  variantValues GlobalVariantOptionValue[]

  @@unique([globalProductId, name])
  @@unique([id, globalProductId])
  @@index([globalProductId, sortOrder])
}

model GlobalProductOptionValue {
  id        Int      @id @default(autoincrement())
  optionId  Int
  value     String   @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  option        GlobalProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues GlobalVariantOptionValue[]

  @@unique([optionId, value])
  @@unique([id, optionId])
}

model GlobalVariantOptionValue {
  globalVariantId Int
  globalProductId Int
  optionId        Int
  optionValueId   Int

  globalVariant GlobalProductVariant     @relation(fields: [globalVariantId, globalProductId], references: [id, globalProductId], onDelete: Cascade)
  option        GlobalProductOption      @relation(fields: [optionId, globalProductId], references: [id, globalProductId], onDelete: NoAction)
  optionValue   GlobalProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Restrict)

  @@id([globalVariantId, optionId])
  @@index([optionValueId])
  @@index([optionId, globalProductId])
}

model GlobalProductVariant {
  id              Int      @id @default(autoincrement())
  globalProductId Int
  name            String   @db.VarChar(180)
  barcode         String?  @unique @db.VarChar(80)
  // Same format as ProductVariant.optionsKey: "12:45|13:47", default variant = "".
  optionsKey      String   @default("") @db.VarChar(255)
  imageUrl        String?  @db.VarChar(2048)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  globalProduct GlobalProduct              @relation(fields: [globalProductId], references: [id], onDelete: Cascade)
  optionValues  GlobalVariantOptionValue[]
  shopVariants  ProductVariant[]
  // One default per product — partial unique index in db_constraints.sql.

  @@unique([globalProductId, optionsKey])
  @@unique([id, globalProductId])
  @@index([globalProductId, isActive, sortOrder])
}

// -----------------------------------------------------------------------------
// PRODUCT VARIANTS
// -----------------------------------------------------------------------------

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductOptionValue[]
  variantValues VariantOptionValue[]

  @@unique([productId, name])
  @@unique([id, productId])
  @@index([productId, sortOrder])
}

model ProductOptionValue {
  id        Int      @id @default(autoincrement())
  optionId  Int
  value     String   @db.VarChar(80)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  option        ProductOption        @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues VariantOptionValue[]

  @@unique([optionId, value])
  @@unique([id, optionId])
}

// Sellable + stockable unit of a product.
// NOTE: the single `barcode` column was removed — all barcodes live in ProductBarcode.
model ProductVariant {
  id                Int      @id @default(autoincrement())
  shopId            Int
  productId         Int
  // Must belong to the product's globalProductId; validate this cross-parent rule in the catalog service.
  globalVariantId   Int?
  name              String   @db.VarChar(180)
  sku               String   @db.VarChar(80)
  // Canonical key: option IDs sorted ascending, each encoded as optionId:valueId,
  // joined with "|"; simple/default variant uses exactly "". Never trust a client-supplied key.
  optionsKey        String   @default("") @db.VarChar(255)
  sellingPrice      Decimal  @default(0) @db.Decimal(19, 4)
  // Alert level (low-stock notification) and suggested re-order quantity.
  lowStockThreshold Decimal  @default(0) @db.Decimal(14, 3)
  reorderQty        Decimal  @default(0) @db.Decimal(14, 3)
  imageUrl          String?  @db.VarChar(2048)
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  product                  Product                 @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  globalVariant            GlobalProductVariant?   @relation(fields: [globalVariantId], references: [id], onDelete: SetNull)
  optionValues             VariantOptionValue[]
  barcodes                 ProductBarcode[]
  stockLevel               StockLevel?
  batches                  PurchaseBatch[]
  movements                InventoryMovement[]
  purchaseItems            PurchaseItem[]
  stocktakeItems           StocktakeItem[]
  stockReservations        StockReservation[]
  saleItems                SaleItem[]
  orderItems               OrderItem[]
  losses                   InventoryLoss[]
  priceHistory             ProductPriceHistory[]
  promotions               Promotion[]
  // v4: stock transfers (this variant as the sending / receiving side)
  transferItemsOut         StockTransferItem[]     @relation("TransferFromVariant")
  transferItemsIn          StockTransferItem[]     @relation("TransferToVariant")
  locationStockLevels      LocationStockLevel[]
  locationBatchStockLevels LocationBatchStock[]
  warehouseTransferItems   WarehouseTransferItem[]
  websiteListings          WebsiteVariantListing[]
  // One default per product + trigram indexes — db_constraints.sql.
  cartItems                CartItem[]

  @@unique([shopId, sku])
  // Prevents duplicate canonical option combinations within a product.
  @@unique([productId, optionsKey])
  @@unique([id, shopId])
  // Compound target: ties variant and its product together (SaleItem, OrderItem, VariantOptionValue).
  @@unique([id, productId])
  @@unique([id, productId, shopId])
  @@index([productId, isActive, sortOrder])
  @@index([shopId, isActive])
  @@index([globalVariantId])
}

// Every barcode of a variant. A carton barcode uses unitQuantity = 12 (scan once -> 12 units).
model ProductBarcode {
  id           Int      @id @default(autoincrement())
  shopId       Int
  variantId    Int
  barcode      String   @db.VarChar(80)
  unitQuantity Decimal  @default(1) @db.Decimal(14, 3)
  label        String?  @db.VarChar(80)
  // One primary barcode per variant — partial unique index in db_constraints.sql.
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([shopId, barcode])
  @@index([variantId])
}

model VariantOptionValue {
  variantId     Int
  productId     Int
  optionId      Int
  optionValueId Int

  variant     ProductVariant     @relation(fields: [variantId, productId], references: [id, productId], onDelete: Cascade)
  option      ProductOption      @relation(fields: [optionId, productId], references: [id, productId], onDelete: NoAction)
  optionValue ProductOptionValue @relation(fields: [optionValueId, optionId], references: [id, optionId], onDelete: Restrict)

  @@id([variantId, optionId])
  @@index([optionValueId])
  @@index([optionId, productId])
}

// -----------------------------------------------------------------------------
// STOCK / PURCHASING / SUPPLIERS
// -----------------------------------------------------------------------------

// Fast read projection of stock per variant. Reconcile atomically with InventoryMovement.
// Product-level stock = sum over its variants; location totals must reconcile to this cache.
model StockLevel {
  variantId Int      @id
  shopId    Int
  onHand    Decimal  @default(0) @db.Decimal(14, 3)
  // Active reservation projection; available = onHand - reserved.
  reserved  Decimal  @default(0) @db.Decimal(14, 3)
  // Weighted-average unit cost (used when Product.valuationMethod = WEIGHTED_AVERAGE).
  avgCost   Decimal  @default(0) @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([variantId, shopId])
  @@index([shopId, onHand])
  @@index([shopId, reserved])
}

model Supplier {
  id                 Int      @id @default(autoincrement())
  shopId             Int
  name               String   @db.VarChar(160)
  contact            String?  @db.VarChar(255)
  email              String?  @db.VarChar(254)
  phone              String?  @db.VarChar(40)
  address            String?  @db.VarChar(500)
  note               String?  @db.VarChar(500)
  // v4: default credit period given by the supplier (Purchase.dueDate = receivedAt + paymentTermsDays).
  paymentTermsDays   Int      @default(0)
  // DERIVED CACHE: reconcile from SupplierLedgerEntry; update atomically in the application service.
  // +ve = the shop owes the supplier (supplier outstanding), -ve = supplier advance.
  outstandingBalance Decimal  @default(0) @db.Decimal(19, 4)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  shop            Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  batches         PurchaseBatch[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  payments        SupplierPayment[]
  ledgerEntries   SupplierLedgerEntry[]

  @@unique([id, shopId])
  @@index([shopId, name])
}

// Purchase order / goods receipt (header).
// Payable of a purchase = totalAmount - amountPaid - returnedTotal.
model Purchase {
  id                  Int                   @id @default(autoincrement())
  shopId              Int
  supplierId          Int
  purchaseNumber      String                @db.VarChar(80)
  supplierInvoiceNo   String?               @db.VarChar(80)
  receivingLocationId Int?
  status              PurchaseStatus        @default(DRAFT)
  orderedAt           DateTime?             @db.Timestamptz(6)
  expectedAt          DateTime?             @db.Timestamptz(6)
  receivedAt          DateTime?             @db.Timestamptz(6)
  dueDate             DateTime?             @db.Timestamptz(6)
  canceledAt          DateTime?             @db.Timestamptz(6)
  cancelReason        String?               @db.VarChar(500)
  subtotal            Decimal               @default(0) @db.Decimal(19, 4)
  discountTotal       Decimal               @default(0) @db.Decimal(19, 4)
  taxTotal            Decimal               @default(0) @db.Decimal(19, 4)
  shippingTotal       Decimal               @default(0) @db.Decimal(19, 4)
  totalAmount         Decimal               @default(0) @db.Decimal(19, 4)
  // DERIVED CACHE: reconcile from SupplierPaymentAllocation and PurchaseReturn in application transactions.
  paymentStatus       PurchasePaymentStatus @default(UNPAID)
  amountPaid          Decimal               @default(0) @db.Decimal(19, 4)
  returnedTotal       Decimal               @default(0) @db.Decimal(19, 4)
  note                String?               @db.VarChar(500)
  createdById         Int
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  shop              Shop                        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier          Supplier                    @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy         ShopMember                  @relation("PurchaseCreator", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)
  receivingLocation InventoryLocation?          @relation("PurchaseReceivingLocation", fields: [receivingLocationId, shopId], references: [id, shopId], onDelete: Restrict)
  items             PurchaseItem[]
  returns           PurchaseReturn[]
  allocations       SupplierPaymentAllocation[]
  ledgerEntries     SupplierLedgerEntry[]

  @@unique([shopId, purchaseNumber])
  // The same supplier invoice cannot be entered twice (NULLs allowed).
  @@unique([shopId, supplierId, supplierInvoiceNo])
  @@unique([id, shopId])
  @@unique([id, shopId, supplierId])
  @@index([shopId, supplierId, status])
  @@index([shopId, paymentStatus, dueDate])
  @@index([shopId, createdAt])
  @@index([shopId, receivingLocationId, status])
}

model PurchaseItem {
  id             Int       @id @default(autoincrement())
  purchaseId     Int
  shopId         Int
  variantId      Int
  // Optional shop-owned tax rate; the snapshot remains authoritative for historical calculations.
  taxRateId      Int?
  orderedQty     Decimal   @db.Decimal(14, 3)
  receivedQty    Decimal   @default(0) @db.Decimal(14, 3)
  costPerUnit    Decimal   @db.Decimal(19, 4)
  // v4: discount + tax snapshots of this line.
  discountAmount Decimal   @default(0) @db.Decimal(19, 4)
  taxRatePercent Decimal   @default(0) @db.Decimal(7, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(19, 4)
  lineTotal      Decimal   @db.Decimal(19, 4)
  batchNumber    String?   @db.VarChar(100)
  expiryDate     DateTime? @db.Date

  purchase Purchase        @relation(fields: [purchaseId, shopId], references: [id, shopId], onDelete: Cascade)
  variant  ProductVariant  @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  taxRate  TaxRate?        @relation(fields: [taxRateId, shopId], references: [id, shopId], onDelete: Restrict)
  batches  PurchaseBatch[]

  @@unique([id, shopId])
  @@unique([id, shopId, variantId])
  @@index([shopId, purchaseId])
  @@index([shopId, variantId])
}

model PurchaseBatch {
  id                   Int       @id @default(autoincrement())
  shopId               Int
  variantId            Int
  supplierId           Int?
  purchaseItemId       Int?
  // v4: set when this batch was created by RECEIVING a stock transfer from another shop.
  sourceTransferItemId Int?
  batchNumber          String?   @db.VarChar(100)
  quantity             Decimal   @db.Decimal(14, 3)
  // DERIVED projection; update only in the same transaction that inserts InventoryMovement.
  remaining            Decimal   @db.Decimal(14, 3)
  costPerUnit          Decimal   @db.Decimal(19, 4)
  sellPrice            Decimal?  @db.Decimal(19, 4)
  purchasedAt          DateTime  @default(now()) @db.Timestamptz(6)
  expiryDate           DateTime? @db.Date
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)

  shop                   Shop                     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  variant                ProductVariant           @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  // Nullable parent ids use RESTRICT so the required shopId is never nulled by FK actions.
  supplier               Supplier?                @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Restrict)
  purchaseItem           PurchaseItem?            @relation(fields: [purchaseItemId, shopId, variantId], references: [id, shopId, variantId], onDelete: Restrict)
  // Receiving shop is constrained to StockTransferItem.toShopId.
  sourceTransferItem     StockTransferItem?       @relation("TransferReceivedBatches", fields: [sourceTransferItemId, shopId], references: [id, toShopId], onDelete: Restrict)
  saleLinks              SaleItemBatch[]
  losses                 InventoryLoss[]
  returnItems            ReturnItem[]
  promotions             Promotion[]
  movements              InventoryMovement[]
  purchaseReturnItems    PurchaseReturnItem[]
  transferLinks          StockTransferItemBatch[]
  warehouseTransferLinks WarehouseTransferBatch[]
  locationStockLevels    LocationBatchStock[]

  @@unique([id, shopId])
  // Compound target: batch and variant are tied together (SaleItemBatch, PurchaseReturnItem).
  @@unique([id, variantId, shopId])
  @@index([shopId, variantId, purchasedAt])
  @@index([expiryDate])
  @@index([shopId, supplierId])
  @@index([shopId, purchaseItemId])
  @@index([shopId, sourceTransferItemId])
}

// Return goods to a supplier.
model PurchaseReturn {
  id           Int      @id @default(autoincrement())
  shopId       Int
  supplierId   Int
  purchaseId   Int?
  returnNumber String   @db.VarChar(80)
  totalAmount  Decimal  @db.Decimal(19, 4)
  reason       String?  @db.VarChar(500)
  createdById  Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  shop          Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier      Supplier              @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Restrict)
  purchase      Purchase?             @relation(fields: [purchaseId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)
  createdBy     ShopMember            @relation("PurchaseReturnCreator", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)
  items         PurchaseReturnItem[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([shopId, returnNumber])
  @@unique([id, shopId])
  @@unique([id, shopId, supplierId])
  @@index([shopId, supplierId, createdAt])
}

model PurchaseReturnItem {
  id               Int     @id @default(autoincrement())
  purchaseReturnId Int
  shopId           Int
  variantId        Int
  batchId          Int
  quantity         Decimal @db.Decimal(14, 3)
  unitCost         Decimal @db.Decimal(19, 4)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId, shopId], references: [id, shopId], onDelete: Restrict)
  // batch, variant and shop are all tied together.
  batch          PurchaseBatch  @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  @@index([purchaseReturnId])
  @@index([batchId])
}

// Money paid to a supplier = the PURCHASE PAYMENT.
// One payment can settle several purchases (allocations). Unallocated remainder = supplier advance.
// A CASH payment taken from the till carries shiftId, so the shift's expectedCash drops accordingly.
model SupplierPayment {
  id          Int           @id @default(autoincrement())
  shopId      Int
  supplierId  Int
  // Same-shop shift ownership is validated by the POS service; legacy relation retained for compatibility.
  shiftId     Int?
  method      PaymentMethod @default(CASH)
  amount      Decimal       @db.Decimal(19, 4)
  reference   String?       @db.VarChar(120)
  note        String?       @db.VarChar(500)
  paidAt      DateTime      @default(now()) @db.Timestamptz(6)
  createdById Int
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  shop          Shop                        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  supplier      Supplier                    @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Restrict)
  shift         CashShift?                  @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy     ShopMember                  @relation("SupplierPaymentCreator", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)
  allocations   SupplierPaymentAllocation[]
  ledgerEntries SupplierLedgerEntry[]

  @@unique([id, shopId])
  @@unique([id, shopId, supplierId])
  @@index([shopId, supplierId, paidAt])
  @@index([shiftId, method])
}

model SupplierPaymentAllocation {
  paymentId  Int
  purchaseId Int
  shopId     Int
  supplierId Int
  amount     Decimal @db.Decimal(19, 4)

  payment  SupplierPayment @relation(fields: [paymentId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)
  purchase Purchase        @relation(fields: [purchaseId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)

  @@id([paymentId, purchaseId])
  @@index([shopId, purchaseId])
}

// v4: Append-only supplier payable ledger (supplier outstanding). Application transactions
// insert ledger rows and reconcile Supplier.outstandingBalance; never mutate posted ledger rows.
//   goods received on credit  -> PURCHASE        (+ Purchase.totalAmount, purchaseId)
//   money paid                -> PAYMENT         (- payment.amount, supplierPaymentId)
//   goods returned            -> PURCHASE_RETURN (- return.totalAmount, purchaseReturnId)
// Supplier statement = SELECT ... ORDER BY createdAt, id with a running SUM() window.
model SupplierLedgerEntry {
  id                Int                     @id @default(autoincrement())
  shopId            Int
  supplierId        Int
  type              SupplierLedgerEntryType
  // Signed. +ve = the shop owes the supplier more. Never 0.
  amount            Decimal                 @db.Decimal(19, 4)
  // Source documents are optional but, when present, must belong to this shop.
  purchaseId        Int?
  supplierPaymentId Int?
  purchaseReturnId  Int?
  note              String?                 @db.VarChar(500)
  createdById       Int?
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)

  supplier        Supplier         @relation(fields: [supplierId, shopId], references: [id, shopId], onDelete: Restrict)
  purchase        Purchase?        @relation(fields: [purchaseId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)
  purchaseReturn  PurchaseReturn?  @relation(fields: [purchaseReturnId, shopId, supplierId], references: [id, shopId, supplierId], onDelete: Restrict)
  createdBy       ShopMember?      @relation("SupplierLedgerActor", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)

  @@index([shopId, supplierId, createdAt])
  @@index([shopId, purchaseId])
  @@index([shopId, supplierPaymentId])
  @@index([shopId, purchaseReturnId])
}

// Append-only stock ledger; application transactions also update StockLevel and batch/location projections.
model InventoryMovement {
  id                      Int                   @id @default(autoincrement())
  shopId                  Int
  variantId               Int
  batchId                 Int?
  locationId              Int?
  warehouseTransferItemId Int?
  idempotencyKey          String?               @db.VarChar(120)
  type                    InventoryMovementType
  // Signed quantity delta: positive adds stock, negative removes stock. Never 0.
  quantityDelta           Decimal               @db.Decimal(14, 3)
  unitCost                Decimal?              @db.Decimal(19, 4)
  // Stock transfer movements link to their transfer item; reference fields remain available for legacy transfers.
  referenceType           String?               @db.VarChar(40)
  referenceId             String?               @db.VarChar(100)
  note                    String?               @db.VarChar(500)
  createdById             Int?
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)

  shop                  Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  variant               ProductVariant         @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  // Composite relation enforces that the batch belongs to the same shop and variant.
  batch                 PurchaseBatch?         @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)
  location              InventoryLocation?     @relation("MovementLocation", fields: [locationId, shopId], references: [id, shopId], onDelete: Restrict)
  warehouseTransferItem WarehouseTransferItem? @relation(fields: [warehouseTransferItemId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)
  createdBy             ShopMember?            @relation("MovementActor", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, variantId, createdAt])
  @@index([shopId, referenceType, referenceId])
  @@index([shopId, batchId])
  @@index([shopId, locationId, variantId, createdAt])
  @@index([shopId, warehouseTransferItemId])
}

// -----------------------------------------------------------------------------
// STOCK TRANSFER (v4) — shop -> shop, both shops must have the SAME owner
// Flow:
//   1. DRAFT      : user picks items; nothing moves.
//   2. IN_TRANSIT : "send" — in ONE transaction, for every item insert STOCK_TRANSFER_OUT
//                   movements against the source batches (FIFO/LIFO), write StockTransferItemBatch
//                   rows and freeze unitCost.
//   3. RECEIVED / PARTIALLY_RECEIVED : "receive" — map each line to a variant of the receiving shop
//                   (toVariantId, matched by barcode / sku / globalVariantId, or created on the fly),
//                   insert a PurchaseBatch (sourceTransferItemId, costPerUnit = item.unitCost,
//                   remaining = 0) + a STOCK_TRANSFER_IN movement, set receivedQty.
//   Shortage / damage in transit = quantity - receivedQty: the sender books it as a loss
//   (InventoryLoss) or re-adds it with an ADJUSTMENT_IN. Stock in transit belongs to nobody's
//   StockLevel.onHand (it has left the sender and has not reached the receiver yet).
// -----------------------------------------------------------------------------

model StockTransfer {
  id             Int                 @id @default(autoincrement())
  fromShopId     Int
  toShopId       Int
  // Numbered from the SENDER'S ReceiptSequence key "TRANSFER".
  transferNumber String              @db.VarChar(80)
  status         StockTransferStatus @default(DRAFT)
  note           String?             @db.VarChar(500)
  // Actor FKs require a membership in the sending / receiving shop; ACTIVE status is checked by service.
  createdById    Int
  receivedById   Int?
  shippedAt      DateTime?           @db.Timestamptz(6)
  receivedAt     DateTime?           @db.Timestamptz(6)
  canceledAt     DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  fromShop   Shop                @relation("TransferFromShop", fields: [fromShopId], references: [id], onDelete: Restrict)
  toShop     Shop                @relation("TransferToShop", fields: [toShopId], references: [id], onDelete: Restrict)
  createdBy  ShopMember          @relation("TransferCreator", fields: [fromShopId, createdById], references: [shopId, userId], onDelete: Restrict)
  receivedBy ShopMember?         @relation("TransferReceiver", fields: [toShopId, receivedById], references: [shopId, userId], onDelete: Restrict)
  items      StockTransferItem[]

  @@unique([fromShopId, transferNumber])
  // Compound target: items are tied to the SENDING shop of the transfer.
  @@unique([id, fromShopId])
  @@unique([id, fromShopId, toShopId])
  @@index([fromShopId, status, createdAt])
  @@index([toShopId, status, createdAt])
}

model StockTransferItem {
  id            Int      @id @default(autoincrement())
  transferId    Int
  // Sender and receiver tenant IDs are copied from the transfer for composite FK enforcement.
  fromShopId    Int
  toShopId      Int
  fromVariantId Int
  // Variant of the receiving shop; NULL until mapped / received.
  toVariantId   Int?
  quantity      Decimal  @db.Decimal(14, 3)
  receivedQty   Decimal  @default(0) @db.Decimal(14, 3)
  // Unit cost frozen when the transfer is sent. Becomes PurchaseBatch.costPerUnit at the receiver.
  unitCost      Decimal  @default(0) @db.Decimal(19, 4)
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  transfer        StockTransfer            @relation(fields: [transferId, fromShopId, toShopId], references: [id, fromShopId, toShopId], onDelete: Cascade)
  fromVariant     ProductVariant           @relation("TransferFromVariant", fields: [fromVariantId, fromShopId], references: [id, shopId], onDelete: Restrict)
  toVariant       ProductVariant?          @relation("TransferToVariant", fields: [toVariantId, toShopId], references: [id, shopId], onDelete: Restrict)
  batchLinks      StockTransferItemBatch[]
  receivedBatches PurchaseBatch[]          @relation("TransferReceivedBatches")

  @@unique([transferId, fromVariantId])
  // Compound target: StockTransferItemBatch is tied to the item's variant AND sending shop.
  @@unique([id, fromVariantId, fromShopId])
  @@unique([id, toShopId])
  @@index([fromVariantId])
  @@index([toVariantId])
}

// Which source batches a transfer line consumed. batch and line share the same variant AND shop.
// sum(quantity) = StockTransferItem.quantity once the transfer is IN_TRANSIT (service layer).
model StockTransferItemBatch {
  id             Int     @id @default(autoincrement())
  transferItemId Int
  batchId        Int
  variantId      Int
  shopId         Int
  quantity       Decimal @db.Decimal(14, 3)

  transferItem StockTransferItem @relation(fields: [transferItemId, variantId, shopId], references: [id, fromVariantId, fromShopId], onDelete: Restrict)
  batch        PurchaseBatch     @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  @@unique([transferItemId, batchId])
  @@index([batchId])
}

// Physical stock count. Completing it creates ADJUSTMENT_IN/OUT movements for the variances.
model Stocktake {
  id          Int             @id @default(autoincrement())
  shopId      Int
  name        String          @db.VarChar(120)
  locationId  Int?
  status      StocktakeStatus @default(IN_PROGRESS)
  note        String?         @db.VarChar(500)
  createdById Int
  startedAt   DateTime        @default(now()) @db.Timestamptz(6)
  completedAt DateTime?       @db.Timestamptz(6)

  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  createdBy ShopMember         @relation("StocktakeCreator", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)
  location  InventoryLocation? @relation("StocktakeLocation", fields: [locationId, shopId], references: [id, shopId], onDelete: Restrict)
  items     StocktakeItem[]

  @@unique([id, shopId])
  @@index([shopId, status])
  @@index([shopId, locationId, status])
}

model StocktakeItem {
  id          Int      @id @default(autoincrement())
  stocktakeId Int
  shopId      Int
  variantId   Int
  // Snapshot of StockLevel.onHand when the count started. Variance = countedQty - expectedQty.
  expectedQty Decimal  @db.Decimal(14, 3)
  countedQty  Decimal? @db.Decimal(14, 3)
  note        String?  @db.VarChar(255)

  stocktake Stocktake      @relation(fields: [stocktakeId, shopId], references: [id, shopId], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([stocktakeId, variantId])
  @@index([variantId])
}

// Stock held for an online order until it is paid / shipped / expires.
// Available to sell = StockLevel.onHand - sum(ACTIVE reservations).
model StockReservation {
  id             Int               @id @default(autoincrement())
  shopId         Int
  variantId      Int
  orderId        Int
  locationId     Int?
  quantity       Decimal           @db.Decimal(14, 3)
  idempotencyKey String?           @db.VarChar(120)
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?         @db.Timestamptz(6)
  consumedAt     DateTime?         @db.Timestamptz(6)
  releasedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  variant  ProductVariant     @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  order    Order              @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  location InventoryLocation? @relation("ReservationLocation", fields: [locationId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([shopId, variantId, status, expiresAt])
  @@index([shopId, orderId])
  @@index([status, expiresAt])
  @@index([shopId, locationId, variantId, status])
}

// -----------------------------------------------------------------------------
// PROMOTIONS
// scope decides which target column is used (enforced by CHECK in db_constraints.sql):
//   PRODUCT -> productId (variantId null = all variants)   VARIANT -> variantId
//   CATEGORY -> localCategoryId   BRAND -> brandId   CART -> none (whole basket / coupon)
// -----------------------------------------------------------------------------

model Promotion {
  id              Int            @id @default(autoincrement())
  shopId          Int
  name            String         @db.VarChar(120)
  scope           PromotionScope @default(PRODUCT)
  discountType    DiscountType
  value           Decimal        @db.Decimal(19, 4)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean        @default(true)
  // Coupon code (optional). Unique per shop; NULLs allowed.
  couponCode      String?        @db.VarChar(40)
  minSubtotal     Decimal?       @db.Decimal(19, 4)
  // Redemptions = count of SaleDiscountLine rows of this promotion on non-voided sales.
  maxUses         Int?
  isStackable     Boolean        @default(false)
  priority        Int            @default(0)
  productId       Int?
  variantId       Int?
  batchId         Int?
  localCategoryId Int?
  brandId         Int?
  createdAt       DateTime       @default(now())

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // All target links must belong to the same shop — trigger.
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  batch             PurchaseBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  localCategory     LocalCategory?     @relation(fields: [localCategoryId], references: [id], onDelete: Cascade)
  brand             Brand?             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]
  sales             Sale[]
  saleDiscountLines SaleDiscountLine[]

  @@unique([shopId, couponCode])
  @@unique([id, shopId])
  @@index([shopId, startDate, endDate])
  @@index([productId, isActive])
  @@index([variantId, isActive])
  @@index([localCategoryId])
  @@index([brandId])
}

// -----------------------------------------------------------------------------
// CASH DRAWER  (Terminal = cash register, CashShift = cash session)
// -----------------------------------------------------------------------------

// One cashier session on one terminal. Z-report = snapshot written when it is closed.
// expectedCash = openingFloat
//              + cash SalePayments (amount, change excluded) whose customerPaymentId IS NULL
//              + cash CustomerPayments (shiftId = this shift)
//              + PAY_IN - PAY_OUT - DROP
//              - cash SaleRefundPayments (SUCCEEDED) - cash SupplierPayments - cash Expenses
// NOTE: SalePayment rows created by a CustomerPayment carry shiftId = NULL (CHECK), so a
// receipt is never counted twice — the drawer is credited through CustomerPayment.shiftId.
// Non-cash methods are reconciled per method in CashShiftTender (card slip total, transfers...).
model CashShift {
  id                     Int         @id @default(autoincrement())
  shopId                 Int
  terminalId             Int
  status                 ShiftStatus @default(OPEN)
  openedById             Int
  closedById             Int?
  openingFloat           Decimal     @db.Decimal(19, 4)
  expectedCash           Decimal?    @db.Decimal(19, 4)
  countedCash            Decimal?    @db.Decimal(19, 4)
  cashDifference         Decimal?    @db.Decimal(19, 4)
  // v4: why the drawer is over / short, and which manager signed it off.
  differenceReason       String?     @db.VarChar(500)
  differenceApprovedById Int?
  zReport                Json?
  note                   String?     @db.VarChar(500)
  openedAt               DateTime    @default(now())
  closedAt               DateTime?

  shop                 Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  terminal             Terminal            @relation(fields: [terminalId, shopId], references: [id, shopId], onDelete: Restrict)
  openedBy             ShopMember          @relation("ShiftOpener", fields: [shopId, openedById], references: [shopId, userId], onDelete: Restrict)
  closedBy             ShopMember?         @relation("ShiftCloser", fields: [shopId, closedById], references: [shopId, userId], onDelete: Restrict)
  differenceApprovedBy ShopMember?         @relation("ShiftDifferenceApprover", fields: [shopId, differenceApprovedById], references: [shopId, userId], onDelete: Restrict)
  movements            CashMovement[]
  sales                Sale[]
  salePayments         SalePayment[]
  returns              Return[]
  expenses             Expense[]
  // v4
  counts               CashShiftCount[]
  tenders              CashShiftTender[]
  customerPayments     CustomerPayment[]
  supplierPayments     SupplierPayment[]
  refundPayments       SaleRefundPayment[]
  // One OPEN shift per terminal — partial unique index in db_constraints.sql.

  @@unique([id, shopId])
  @@index([shopId, status])
  @@index([terminalId, openedAt])
}

// v4: Denomination count of the drawer when a shift is opened / closed
// (e.g. 20 x 1000, 15 x 500). subtotal = denomination * quantity (CHECK).
model CashShiftCount {
  id           Int           @id @default(autoincrement())
  shiftId      Int
  shopId       Int
  kind         CashCountKind
  denomination Decimal       @db.Decimal(19, 4)
  quantity     Int
  subtotal     Decimal       @db.Decimal(19, 4)
  createdAt    DateTime      @default(now())

  shift CashShift @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([shiftId, kind, denomination])
  @@index([shiftId, kind])
}

// v4: Per payment-method reconciliation written when a shift is closed. CASH row mirrors
// CashShift.expectedCash / countedCash; CARD / TRANSFER / CHEQUE rows are compared with the
// card-terminal settlement slip, bank statement etc.
model CashShiftTender {
  id             Int           @id @default(autoincrement())
  shiftId        Int
  shopId         Int
  method         PaymentMethod
  expectedAmount Decimal       @db.Decimal(19, 4)
  countedAmount  Decimal?      @db.Decimal(19, 4)
  difference     Decimal?      @db.Decimal(19, 4)
  note           String?       @db.VarChar(255)
  createdAt      DateTime      @default(now())

  shift CashShift @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([shiftId, method])
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  shiftId     Int
  shopId      Int
  type        CashMovementType
  amount      Decimal          @db.Decimal(19, 4)
  reason      String           @db.VarChar(255)
  createdById Int
  createdAt   DateTime         @default(now())

  shift     CashShift @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy User      @relation("CashMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shiftId])
}

// -----------------------------------------------------------------------------
// POS SALES / RETURNS
// -----------------------------------------------------------------------------

model Sale {
  id               Int               @id @default(autoincrement())
  shopId           Int
  terminalId       Int?
  shiftId          Int?
  cashierId        Int
  customerId       Int?
  // Cart-level promotion / coupon that was applied.
  promotionId      Int?
  // Generated by the client (offline-safe idempotency key). Unique per shop.
  clientUuid       String?           @db.Uuid
  // Assigned from ReceiptSequence when the sale is completed; NULL while HELD.
  receiptNumber    String?           @db.VarChar(80)
  status           SaleStatus        @default(COMPLETED)
  channel          SalesChannel      @default(POS)
  // Maintained by trigger from SalePayment. Anything but PAID needs a customer.
  paymentStatus    SalePaymentStatus @default(UNPAID)
  // v4: snapshots of shop settings at sale time (old receipts never change). The service layer
  // copies Shop.currency / ShopSettings.pricesIncludeTax when the sale is created.
  currency         String            @default("USD") @db.VarChar(3)
  pricesIncludeTax Boolean           @default(false)
  // v4: when the unpaid part of a credit sale is due.
  creditDueDate    DateTime?         @db.Date

  subtotal           Decimal @db.Decimal(19, 4)
  discountTotal      Decimal @default(0) @db.Decimal(19, 4)
  cartDiscountAmount Decimal @default(0) @db.Decimal(19, 4)
  cartDiscountReason String? @db.VarChar(255)
  taxTotal           Decimal @default(0) @db.Decimal(19, 4)
  // Signed (+/-) rounding adjustment.
  roundingAmount     Decimal @default(0) @db.Decimal(19, 4)
  totalAmount        Decimal @db.Decimal(19, 4)
  // DERIVED from SalePayment by trigger.
  amountPaid         Decimal @default(0) @db.Decimal(19, 4)

  note             String?   @db.VarChar(500)
  heldAt           DateTime?
  completedAt      DateTime?
  offlineCreatedAt DateTime?
  syncedAt         DateTime?
  voidedAt         DateTime?
  voidedById       Int?
  voidReason       String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop                Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  // All POS-owned references include shopId; nullable links use RESTRICT so shopId is never nulled.
  terminal            Terminal?             @relation(fields: [terminalId, shopId], references: [id, shopId], onDelete: Restrict)
  shift               CashShift?            @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  cashier             ShopMember            @relation("SaleCashier", fields: [shopId, cashierId], references: [shopId, userId], onDelete: Restrict)
  voidedBy            ShopMember?           @relation("SaleVoider", fields: [shopId, voidedById], references: [shopId, userId], onDelete: Restrict)
  customer            Customer?             @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  promotion           Promotion?            @relation(fields: [promotionId, shopId], references: [id, shopId], onDelete: Restrict)
  items               SaleItem[]
  payments            SalePayment[]
  returns             Return[]
  loyaltyTransactions LoyaltyTransaction[]
  // v4
  taxLines            SaleTaxLine[]
  discountLines       SaleDiscountLine[]
  creditEntries       CustomerCreditEntry[]

  @@unique([shopId, receiptNumber])
  @@unique([shopId, clientUuid])
  @@unique([id, shopId])
  @@unique([id, shopId, customerId])
  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([shopId, paymentStatus, creditDueDate])
  @@index([shiftId])
  @@index([cashierId])
  @@index([customerId])
  @@index([terminalId])
}

// A tender line. Split payments = several rows (Cash 500 + Card 1500).
// amount = the part applied to the sale; tenderedAmount = what the customer handed over.
// Later credit repayments are more rows on the same sale:
//   * paid at the till for ONE sale  -> a plain SalePayment (shiftId = current shift)
//   * one receipt for MANY sales     -> a CustomerPayment + one SalePayment per settled sale
//     (customerPaymentId set, shiftId NULL — the drawer is credited via CustomerPayment.shiftId)
// method STORE_CREDIT consumes a balance the shop owes the customer (see CustomerCreditEntry).
model SalePayment {
  id                Int           @id @default(autoincrement())
  saleId            Int
  shopId            Int
  shiftId           Int?
  // v4: set when this row is the allocation of a CustomerPayment — same shop / customer — trigger.
  customerPaymentId Int?
  // v4: cashier who took the money (ACTIVE member of the shop — trigger).
  receivedById      Int?
  method            PaymentMethod
  amount            Decimal       @db.Decimal(19, 4)
  tenderedAmount    Decimal?      @db.Decimal(19, 4)
  changeAmount      Decimal       @default(0) @db.Decimal(19, 4)
  reference         String?       @db.VarChar(120)
  // v4: card terminal details (never store the full PAN / CVV).
  cardBrand         String?       @db.VarChar(30)
  cardLast4         String?       @db.VarChar(4)
  authCode          String?       @db.VarChar(40)
  // v4: offline-safe idempotency key of this tender line. Unique per shop.
  clientUuid        String?       @db.Uuid
  createdAt         DateTime      @default(now())

  sale            Sale                @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  shift           CashShift?          @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  customerPayment CustomerPayment?    @relation(fields: [customerPaymentId, shopId], references: [id, shopId], onDelete: Restrict)
  receivedBy      ShopMember?         @relation("SalePaymentReceiver", fields: [shopId, receivedById], references: [shopId, userId], onDelete: Restrict)
  refunds         SaleRefundPayment[] @relation("RefundOfPayment")

  @@unique([shopId, clientUuid])
  @@unique([id, shopId])
  @@index([saleId, shopId])
  @@index([shiftId, method])
  @@index([customerPaymentId])
  @@index([shopId, createdAt])
}

// productId is kept for product-level reporting; variantId drives stock/cost.
// The (variantId, productId) FK guarantees the variant really belongs to that product.
// productName / variantName / sku / prices / tax / discount are snapshots taken at sale time.
model SaleItem {
  id             Int            @id @default(autoincrement())
  saleId         Int
  shopId         Int
  productId      Int
  variantId      Int
  promotionId    Int?
  taxRateId      Int?
  productName    String         @db.VarChar(180)
  variantName    String?        @db.VarChar(180)
  sku            String         @db.VarChar(80)
  quantity       Decimal        @db.Decimal(14, 3)
  // Catalog price at the moment of sale vs the price actually charged (price override).
  listPrice      Decimal        @db.Decimal(19, 4)
  price          Decimal        @db.Decimal(19, 4)
  costAtSale     Decimal        @db.Decimal(19, 4)
  // = sum(SaleDiscountLine.amount) of this line.
  discountAmount Decimal        @default(0) @db.Decimal(19, 4)
  discountSource DiscountSource @default(NONE)
  discountReason String?        @db.VarChar(255)
  // Tax snapshot: name / code / rate / inclusive flag as they were at sale time.
  taxName        String?        @db.VarChar(60)
  taxCode        String?        @db.VarChar(20)
  taxRatePercent Decimal        @default(0) @db.Decimal(7, 4)
  isTaxInclusive Boolean        @default(false)
  taxAmount      Decimal        @default(0) @db.Decimal(19, 4)
  lineTotal      Decimal        @db.Decimal(19, 4)
  isVoided       Boolean        @default(false)
  voidedAt       DateTime?
  voidedById     Int?
  voidReason     String?        @db.VarChar(255)
  createdAt      DateTime       @default(now())

  sale          Sale               @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  product       Product            @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  variant       ProductVariant     @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  // promotion / taxRate must belong to the same shop — trigger.
  promotion     Promotion?         @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  taxRate       TaxRate?           @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  voidedBy      ShopMember?        @relation("SaleItemVoider", fields: [shopId, voidedById], references: [shopId, userId], onDelete: Restrict)
  batchLinks    SaleItemBatch[]
  returnItems   ReturnItem[]
  discountLines SaleDiscountLine[]

  @@unique([id, shopId])
  @@unique([id, saleId, shopId])
  @@unique([id, saleId, shopId, variantId])
  @@unique([id, variantId, shopId])
  @@index([saleId])
  @@index([shopId, productId])
  @@index([shopId, variantId])
  @@index([promotionId])
}

// Which batches a sale line consumed. batch and line are tied to the same variant AND shop.
// sum(quantity) <= SaleItem.quantity is enforced by a deferred trigger (it may be lower
// when negative stock is allowed and some units had no batch).
model SaleItemBatch {
  id         Int     @id @default(autoincrement())
  saleItemId Int
  batchId    Int
  variantId  Int
  shopId     Int
  quantity   Decimal @db.Decimal(14, 3)

  saleItem SaleItem      @relation(fields: [saleItemId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)
  batch    PurchaseBatch @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  @@unique([saleItemId, batchId])
  @@index([batchId])
}

// v4: TAX SNAPSHOT of a sale, grouped by tax rate (what the receipt / VAT return prints).
// Rebuilt from the sale lines when the sale is completed; never edited afterwards.
// sum(taxAmount) = Sale.taxTotal.   taxRateId is only a pointer — the name / code / rate
// columns are the truth, so editing or deleting a TaxRate never changes an old receipt.
model SaleTaxLine {
  id            Int      @id @default(autoincrement())
  saleId        Int
  shopId        Int
  // must belong to the same shop — trigger.
  taxRateId     Int?
  name          String   @db.VarChar(60)
  code          String?  @db.VarChar(20)
  ratePercent   Decimal  @db.Decimal(7, 4)
  isInclusive   Boolean  @default(false)
  // Net amount the tax was calculated on.
  taxableAmount Decimal  @db.Decimal(19, 4)
  taxAmount     Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  sale    Sale     @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@unique([saleId, name, ratePercent])
  @@index([shopId, taxRateId])
}

// v4: DISCOUNT SNAPSHOT — one row per discount actually applied to a sale.
//   saleItemId set   -> line discount;   saleItemId NULL -> cart-level discount (coupon / manual).
//   sum(amount of a line's rows)   = SaleItem.discountAmount
//   sum(amount of cart-level rows) = Sale.cartDiscountAmount
// name / value / type are copied from the Promotion so editing it later does not change history.
// A promotion's redemption count (maxUses) = number of rows of that promotion on non-voided sales.
model SaleDiscountLine {
  id           Int            @id @default(autoincrement())
  saleId       Int
  shopId       Int
  // Must be a line of THIS sale — trigger.
  saleItemId   Int?
  promotionId  Int?
  source       DiscountSource
  discountType DiscountType
  // As entered: a percentage for PERCENT, a currency amount for FIXED.
  value        Decimal        @db.Decimal(19, 4)
  // Money actually deducted (always >= 0).
  amount       Decimal        @db.Decimal(19, 4)
  nameSnapshot String?        @db.VarChar(120)
  couponCode   String?        @db.VarChar(40)
  reason       String?        @db.VarChar(255)
  // Manager who approved a MANUAL discount above ShopSettings.maxCashierDiscountPercent.
  approvedById Int?
  createdAt    DateTime       @default(now())

  sale       Sale       @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  saleItem   SaleItem?  @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  promotion  Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  approvedBy User?      @relation("DiscountApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([saleItemId])
  @@index([promotionId])
  @@index([shopId, createdAt])
}

model Return {
  id             Int           @id @default(autoincrement())
  saleId         Int
  shopId         Int
  shiftId        Int?
  processedById  Int
  clientUuid     String?       @db.Uuid
  returnNumber   String?       @db.VarChar(80)
  // Kept for backward compatibility = the PRIMARY refund method. The real tenders
  // (split refunds, store credit...) live in SaleRefundPayment.
  
  // = sum(ReturnItem.refundAmount). sum(SaleRefundPayment where status <> FAILED) may never
  // exceed it (deferred trigger, db_constraints_v4.sql); the service layer makes it equal.
  totalRefunded  Decimal       @db.Decimal(19, 4)
  // v4: tax part of totalRefunded = sum(ReturnItem.taxRefundAmount).
  taxRefundTotal Decimal       @default(0) @db.Decimal(19, 4)
  reason         String?       @db.VarChar(500)
  createdAt      DateTime      @default(now())

  // Tenant-safe: a return can only reference a sale of the same shop.
  sale           Sale                  @relation(fields: [saleId, shopId], references: [id, shopId], onDelete: Restrict)
  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shift          CashShift?            @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  processedBy    ShopMember            @relation("ReturnProcessor", fields: [shopId, processedById], references: [shopId, userId], onDelete: Restrict)
  items          ReturnItem[]
  refundPayments SaleRefundPayment[]
  creditEntries  CustomerCreditEntry[]

  @@unique([id, shopId])
  // Compound target: ReturnItem is tied to the return's sale AND shop.
  @@unique([id, saleId, shopId])
  @@unique([shopId, clientUuid])
  @@unique([shopId, returnNumber])
  @@index([shopId, createdAt])
  @@index([shiftId])
}

// returnId, saleItemId and shopId must all point at the SAME sale (composite FKs).
// A trigger blocks returning more than sold (quantity and refund amount).
model ReturnItem {
  id              Int     @id @default(autoincrement())
  returnId        Int
  saleId          Int
  shopId          Int
  saleItemId      Int
  variantId       Int
  batchId         Int?
  quantity        Decimal @db.Decimal(14, 3)
  // Amount handed back to the customer for this line (tax included).
  refundAmount    Decimal @db.Decimal(19, 4)
  // v4: the tax part of refundAmount (0 <= taxRefundAmount <= refundAmount).
  taxRefundAmount Decimal @default(0) @db.Decimal(19, 4)
  isRestocked     Boolean @default(true)

  return   Return         @relation(fields: [returnId, saleId, shopId], references: [id, saleId, shopId], onDelete: Restrict)
  saleItem SaleItem       @relation(fields: [saleItemId, saleId, shopId, variantId], references: [id, saleId, shopId, variantId], onDelete: Restrict)
  // Batch is constrained to the same shop and variant as the returned sale line.
  batch    PurchaseBatch? @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
}

// v4: HOW a Return was refunded. A return can be refunded in several tenders
// (Cash 500 + Card 1500, or part to STORE_CREDIT). Rules:
//   * CASH refund      -> shiftId = the open shift (reduces CashShift.expectedCash)
//   * CARD / TRANSFER  -> status PENDING until the provider confirms, then SUCCEEDED / FAILED
//   * STORE_CREDIT     -> also insert a CustomerCreditEntry (RETURN_CREDIT, -amount, returnId)
//   * originalPaymentId (optional) = the SalePayment this money goes back to (card refunds
//     must be sent to the original card).
// sum(amount where status <> FAILED) <= Return.totalRefunded — deferred trigger; the service
// layer inserts all tenders of one return in the same transaction so the sum ends up equal.
model SaleRefundPayment {
  id                Int           @id @default(autoincrement())
  returnId          Int
  shopId            Int
  // shift / originalPayment must belong to the same shop — trigger.
  shiftId           Int?
  originalPaymentId Int?
  processedById     Int
  method            PaymentMethod
  amount            Decimal       @db.Decimal(19, 4)
  status            RefundStatus  @default(SUCCEEDED)
  reference         String?       @db.VarChar(120)
  note              String?       @db.VarChar(500)
  // Offline-safe idempotency key. Unique per shop.
  clientUuid        String?       @db.Uuid
  createdAt         DateTime      @default(now())

  return          Return       @relation(fields: [returnId, shopId], references: [id, shopId], onDelete: Restrict)
  shift           CashShift?   @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  originalPayment SalePayment? @relation("RefundOfPayment", fields: [originalPaymentId, shopId], references: [id, shopId], onDelete: Restrict)
  processedBy     ShopMember   @relation("RefundPaymentProcessor", fields: [shopId, processedById], references: [shopId, userId], onDelete: Restrict)

  @@unique([shopId, clientUuid])
  @@index([returnId])
  @@index([shiftId, method])
  @@index([originalPaymentId])
  @@index([shopId, createdAt])
}

// -----------------------------------------------------------------------------
// CRM / LOYALTY / CUSTOMER CREDIT
// Customer receivable (credit sales) is kept in CustomerCreditEntry (ledger) and cached in
// Customer.creditBalance. Per-invoice view = Sale.totalAmount - Sale.amountPaid.
// -----------------------------------------------------------------------------

model Customer {
  id            Int      @id @default(autoincrement())
  shopId        Int
  name          String   @db.VarChar(160)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(254)
  
  note          String?  @db.VarChar(500)
  // Max outstanding balance allowed for credit sales. 0 = no credit.
  creditLimit   Decimal  @default(0) @db.Decimal(19, 4)
  // v4 DERIVED: maintained by trigger from CustomerCreditEntry. Never write it directly.
  // +ve = the customer owes the shop (receivable), -ve = the shop owes the customer (store credit).
  // A credit sale is refused when creditBalance + new credit > creditLimit (trigger).
  creditBalance Decimal  @default(0) @db.Decimal(19, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop                Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales               Sale[]
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  creditEntries       CustomerCreditEntry[]
  payments            CustomerPayment[]
  account             CustomerAccount?
  addresses           CustomerAddress[]
  carts               Cart[]
  wishlists           Wishlist[]
  reviews             ProductReview[]
  couponRedemptions   CouponRedemption[]
  conversations       Conversation[]
  sentChatMessages    ChatMessage[]         @relation("CustomerChatSender")
  messageReadReceipts MessageReadReceipt[]  @relation("CustomerMessageRead")
  conversationEvents  ConversationEvent[]   @relation("CustomerConversationEventActor")

  @@unique([id, shopId])
  @@index([shopId, name])
  @@index([shopId, phone])
  @@index([shopId, creditBalance])
}

// v4: A payment the customer makes AGAINST THEIR BALANCE (receipt voucher), not at the moment
// of a sale. It can settle several credit sales at once:
//   1. insert the CustomerPayment (+ shiftId when cash goes into the drawer)
//   2. for each sale being settled insert a SalePayment { customerPaymentId, shiftId = NULL }
//   3. insert ONE CustomerCreditEntry { type = PAYMENT, amount = -payment.amount, customerPaymentId }
//   sum(SalePayment.amount of this payment) <= amount; the remainder is an advance (negative
//   balance = store credit). The sale's amountPaid / paymentStatus update through the existing trigger.
model CustomerPayment {
  id           Int           @id @default(autoincrement())
  shopId       Int
  customerId   Int
  // shift must belong to the same shop — trigger.
  shiftId      Int?
  receivedById Int
  method       PaymentMethod
  amount       Decimal       @db.Decimal(19, 4)
  reference    String?       @db.VarChar(120)
  note         String?       @db.VarChar(500)
  // Offline-safe idempotency key. Unique per shop.
  clientUuid   String?       @db.Uuid
  paidAt       DateTime      @default(now())
  createdAt    DateTime      @default(now())

  customer      Customer              @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  shift         CashShift?            @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  receivedBy    ShopMember            @relation("CustomerPaymentReceiver", fields: [shopId, receivedById], references: [shopId, userId], onDelete: Restrict)
  salePayments  SalePayment[]
  creditEntries CustomerCreditEntry[]

  @@unique([id, shopId])
  @@unique([id, shopId, customerId])
  @@unique([shopId, clientUuid])
  @@index([shopId, customerId, paidAt])
  @@index([shiftId, method])
}

// v4: Append-only customer receivable ledger. A trigger applies each row to Customer.creditBalance
// (and refuses a CREDIT_SALE above creditLimit). Application code only INSERTs rows:
//   credit sale        -> CREDIT_SALE       (+ unpaid part of the sale, saleId)
//   later repayment    -> PAYMENT           (- amount, customerPaymentId, or saleId for a till payment)
//   refund as credit   -> RETURN_CREDIT     (- amount, returnId)
//   store credit spent -> STORE_CREDIT_USED (+ amount, saleId)
// Customer statement = SELECT ... ORDER BY createdAt, id with a running SUM() window.
model CustomerCreditEntry {
  id                Int                     @id @default(autoincrement())
  shopId            Int
  customerId        Int
  type              CustomerCreditEntryType
  // Signed. +ve = the customer owes the shop more. Never 0. Sign per type is a CHECK.
  amount            Decimal                 @db.Decimal(19, 4)
  // All three links must belong to the same shop (and the same customer) — trigger.
  saleId            Int?
  customerPaymentId Int?
  returnId          Int?
  note              String?                 @db.VarChar(500)
  createdById       Int?
  createdAt         DateTime                @default(now())

  customer        Customer         @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  sale            Sale?            @relation(fields: [saleId, shopId, customerId], references: [id, shopId, customerId], onDelete: Restrict)
  customerPayment CustomerPayment? @relation(fields: [customerPaymentId, shopId, customerId], references: [id, shopId, customerId], onDelete: Restrict)
  return          Return?          @relation(fields: [returnId, shopId], references: [id, shopId], onDelete: Restrict)
  createdBy       ShopMember?      @relation("CustomerCreditActor", fields: [shopId, createdById], references: [shopId, userId], onDelete: Restrict)

  @@index([shopId, customerId, createdAt])
  @@index([saleId])
  @@index([customerPaymentId])
  @@index([returnId])
}

// Points balance = SUM(points). Positive = earned, negative = redeemed / expired.
model LoyaltyTransaction {
  id         Int           @id @default(autoincrement())
  shopId     Int
  customerId Int
  saleId     Int?
  type       LoyaltyTxType
  points     Int
  note       String?       @db.VarChar(255)
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  // sale must belong to the same shop — trigger.
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, createdAt])
}

// -----------------------------------------------------------------------------
// FINANCE / REPORTS
// -----------------------------------------------------------------------------

// v4: Expense grouping (Rent, Electricity, Transport, Salaries...) for P&L reports.
model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  shopId    Int
  name      String   @db.VarChar(80)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([shopId, name])
  @@unique([id, shopId])
}

model Expense {
  id            Int           @id @default(autoincrement())
  shopId        Int
  addedById     Int?
  // Set when the money came out of a cash drawer shift.
  shiftId       Int?
  // v4: must belong to the same shop — trigger.
  categoryId    Int?
  title         String        @db.VarChar(180)
  description   String?       @db.VarChar(500)
  amount        Decimal       @db.Decimal(19, 4)
  paymentMethod PaymentMethod @default(CASH)
  expenseDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  addedBy  User?            @relation("ExpenseCreator", fields: [addedById], references: [id], onDelete: SetNull)
  // shift must belong to the same shop — trigger.
  shift    CashShift?       @relation(fields: [shiftId, shopId], references: [id, shopId], onDelete: Restrict)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([shopId, expenseDate])
  @@index([shiftId])
  @@index([shopId, categoryId, expenseDate])
}

model ProfitReport {
  id            Int      @id @default(autoincrement())
  shopId        Int
  generatedById Int?
  totalSales    Decimal  @db.Decimal(19, 4)
  totalExpenses Decimal  @db.Decimal(19, 4)
  totalLoss     Decimal  @db.Decimal(19, 4)
  netProfit     Decimal  @db.Decimal(19, 4)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime @default(now())

  shop        Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  generatedBy User? @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([shopId, periodStart, periodEnd])
}

// Replaces ShopAnalytics. One row per shop-local day, REBUILT from Sale/Return/Expense
// (idempotent job or on-demand for the affected date) — no write hotspot on checkout,
// no drift, full history. `date` is the day in Shop.timezone.
model DailySalesSummary {
  id            Int      @id @default(autoincrement())
  shopId        Int
  date          DateTime @db.Date
  saleCount     Int      @default(0)
  grossSales    Decimal  @default(0) @db.Decimal(19, 4)
  discountTotal Decimal  @default(0) @db.Decimal(19, 4)
  taxTotal      Decimal  @default(0) @db.Decimal(19, 4)
  netSales      Decimal  @default(0) @db.Decimal(19, 4)
  costTotal     Decimal  @default(0) @db.Decimal(19, 4)
  grossProfit   Decimal  @default(0) @db.Decimal(19, 4)
  refundTotal   Decimal  @default(0) @db.Decimal(19, 4)
  expenseTotal  Decimal  @default(0) @db.Decimal(19, 4)
  rebuiltAt     DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, date])
}

model InventoryLoss {
  id             Int      @id @default(autoincrement())
  shopId         Int
  variantId      Int
  batchId        Int?
  recordedById   Int?
  quantity       Decimal  @db.Decimal(14, 3)
  reason         String   @db.VarChar(500)
  costAtLoss     Decimal  @db.Decimal(19, 4)
  totalLossValue Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now())

  variant    ProductVariant @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  // Composite relation enforces that the batch belongs to the same shop and variant.
  batch      PurchaseBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  shop       Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  recordedBy User?          @relation("LossRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([variantId])
}

model ProductPriceHistory {
  id          Int      @id @default(autoincrement())
  shopId      Int
  variantId   Int
  changedById Int?
  oldPrice    Decimal  @db.Decimal(19, 4)
  newPrice    Decimal  @db.Decimal(19, 4)
  reason      String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  variant   ProductVariant @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  changedBy User?          @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([shopId, createdAt])
}

// -----------------------------------------------------------------------------
/**
 * ADDITIVE INVENTORY + STOREFRONT EXTENSIONS
 * These models extend existing inventory and storefront models. Warehouse transfers
 * are intra-shop; StockTransfer remains the existing inter-shop workflow. Marketplace
 * models and relations are preserved.
 */

// A warehouse is a managed facility within one shop. Stock is held in its
// InventoryLocation records (zones/bins/receiving/picking locations), not on this header.
model Warehouse {
  id           Int             @id @default(autoincrement())
  shopId       Int
  code         String          @db.VarChar(40)
  name         String          @db.VarChar(160)
  status       WarehouseStatus @default(ACTIVE)
  description  String?         @db.VarChar(500)
  contactName  String?         @db.VarChar(120)
  phone        String?         @db.VarChar(40)
  email        String?         @db.VarChar(254)
  addressLine1 String?         @db.VarChar(180)
  addressLine2 String?         @db.VarChar(180)
  city         String?         @db.VarChar(100)
  region       String?         @db.VarChar(100)
  postalCode   String?         @db.VarChar(30)
  countryCode  String?         @db.VarChar(2)
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  shop      Shop                @relation(fields: [shopId], references: [id], onDelete: Restrict)
  locations InventoryLocation[]

  @@unique([shopId, code])
  @@unique([id, shopId])
  @@index([shopId, status, isDefault])
}

// Intra-shop movement between two stock locations (e.g. warehouse bin to shop floor).
// This is distinct from StockTransfer, which moves goods between two different shops.
model WarehouseTransfer {
  id                    Int                     @id @default(autoincrement())
  shopId                Int
  transferNumber        String                  @db.VarChar(80)
  sourceLocationId      Int
  destinationLocationId Int
  status                WarehouseTransferStatus @default(DRAFT)
  requestedById         Int
  approvedById          Int?
  shippedById           Int?
  receivedById          Int?
  requestedAt           DateTime                @default(now()) @db.Timestamptz(6)
  approvedAt            DateTime?               @db.Timestamptz(6)
  shippedAt             DateTime?               @db.Timestamptz(6)
  receivedAt            DateTime?               @db.Timestamptz(6)
  canceledAt            DateTime?               @db.Timestamptz(6)
  note                  String?                 @db.VarChar(500)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  shop                Shop                    @relation(fields: [shopId], references: [id], onDelete: Restrict)
  sourceLocation      InventoryLocation       @relation("WarehouseTransferSourceLocation", fields: [sourceLocationId, shopId], references: [id, shopId], onDelete: Restrict)
  destinationLocation InventoryLocation       @relation("WarehouseTransferDestinationLocation", fields: [destinationLocationId, shopId], references: [id, shopId], onDelete: Restrict)
  requestedBy         ShopMember              @relation("WarehouseTransferRequester", fields: [shopId, requestedById], references: [shopId, userId], onDelete: Restrict)
  approvedBy          ShopMember?             @relation("WarehouseTransferApprover", fields: [shopId, approvedById], references: [shopId, userId], onDelete: Restrict)
  shippedBy           ShopMember?             @relation("WarehouseTransferShipper", fields: [shopId, shippedById], references: [shopId, userId], onDelete: Restrict)
  receivedBy          ShopMember?             @relation("WarehouseTransferReceiver", fields: [shopId, receivedById], references: [shopId, userId], onDelete: Restrict)
  items               WarehouseTransferItem[]

  @@unique([shopId, transferNumber])
  @@unique([id, shopId])
  @@index([shopId, status, requestedAt])
  @@index([shopId, sourceLocationId, status])
  @@index([shopId, destinationLocationId, status])
}

model WarehouseTransferItem {
  id           Int      @id @default(autoincrement())
  transferId   Int
  shopId       Int
  variantId    Int
  requestedQty Decimal  @db.Decimal(14, 3)
  shippedQty   Decimal  @default(0) @db.Decimal(14, 3)
  receivedQty  Decimal  @default(0) @db.Decimal(14, 3)
  unitCost     Decimal? @db.Decimal(19, 4)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  transfer           WarehouseTransfer        @relation(fields: [transferId, shopId], references: [id, shopId], onDelete: Cascade)
  variant            ProductVariant           @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  batchAllocations   WarehouseTransferBatch[]
  inventoryMovements InventoryMovement[]
  shop               Shop                     @relation(fields: [shopId], references: [id])

  @@unique([transferId, variantId])
  @@unique([id, shopId])
  @@unique([id, variantId, shopId])
  @@index([shopId, variantId])
}

// Batch-level provenance for FIFO/LIFO transfers; the service creates paired
// OUT/IN InventoryMovement rows in one transaction at dispatch/receipt.
model WarehouseTransferBatch {
  id             Int      @id @default(autoincrement())
  transferItemId Int
  shopId         Int
  variantId      Int
  batchId        Int
  quantity       Decimal  @db.Decimal(14, 3)
  unitCost       Decimal  @db.Decimal(19, 4)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  transferItem WarehouseTransferItem @relation(fields: [transferItemId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)
  batch        PurchaseBatch         @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  // One source batch may be allocated once per transfer line. The service MUST also
  // validate SUM(quantity) = shippedQty, batch/location availability, and source location.
  @@unique([transferItemId, batchId])
  @@index([shopId, batchId])
}

// Physical stock locations. StockLevel is the shop-wide projection;
// LocationStockLevel and LocationBatchStock are intentional read projections. Keep all three
// reconciled in the same transaction as each InventoryMovement.
model InventoryLocation {
  id               Int                   @id @default(autoincrement())
  shopId           Int
  code             String                @db.VarChar(40)
  name             String                @db.VarChar(120)
  locationType     InventoryLocationType @default(STORE)
  warehouseId      Int?
  parentLocationId Int?
  isPickable       Boolean               @default(true)
  isReceivable     Boolean               @default(true)
  address          String?               @db.VarChar(500)
  isDefault        Boolean               @default(false)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)

  shop                       Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  warehouse                  Warehouse?           @relation(fields: [warehouseId, shopId], references: [id, shopId], onDelete: Restrict)
  parent                     InventoryLocation?   @relation("LocationHierarchy", fields: [parentLocationId, shopId], references: [id, shopId], onDelete: Restrict)
  children                   InventoryLocation[]  @relation("LocationHierarchy")
  stockLevels                LocationStockLevel[]
  batchStockLevels           LocationBatchStock[]
  movements                  InventoryMovement[]  @relation("MovementLocation")
  purchaseReceipts           Purchase[]           @relation("PurchaseReceivingLocation")
  stocktakes                 Stocktake[]          @relation("StocktakeLocation")
  reservations               StockReservation[]   @relation("ReservationLocation")
  outgoingWarehouseTransfers WarehouseTransfer[]  @relation("WarehouseTransferSourceLocation")
  incomingWarehouseTransfers WarehouseTransfer[]  @relation("WarehouseTransferDestinationLocation")

  @@unique([shopId, code])
  @@unique([id, shopId])
  @@index([shopId, warehouseId, locationType])
  @@index([shopId, parentLocationId])
  @@index([shopId, isActive, isDefault])
}

model LocationStockLevel {
  shopId     Int
  locationId Int
  variantId  Int
  onHand     Decimal  @default(0) @db.Decimal(14, 3)
  reserved   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId, shopId], references: [id, shopId], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)

  @@id([locationId, variantId])
  @@index([shopId, variantId])
  @@index([shopId, locationId, onHand])
}

// Batch-level stock by physical location. This projection is updated atomically
// with InventoryMovement rows by the inventory service.
model LocationBatchStock {
  shopId     Int
  locationId Int
  variantId  Int
  batchId    Int
  onHand     Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  location InventoryLocation @relation(fields: [locationId, shopId], references: [id, shopId], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId, shopId], references: [id, shopId], onDelete: Restrict)
  batch    PurchaseBatch     @relation(fields: [batchId, variantId, shopId], references: [id, variantId, shopId], onDelete: Restrict)

  @@id([locationId, batchId])
  @@index([shopId, variantId, locationId])
  @@index([shopId, batchId, onHand])
}

// Product facts/specifications are distinct from variant options such as size
// and colour. Examples: material = cotton; warranty = 12 months.
model ProductSpecification {
  id        Int      @id @default(autoincrement())
  shopId    Int
  productId Int
  name      String   @db.VarChar(100)
  value     String   @db.VarChar(500)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([productId, name])
  @@index([shopId, productId, sortOrder])
}

// Website-specific category tree. It is separate from POS LocalCategory so a
// storefront can curate navigation without changing inventory classification.
model WebsiteCategory {
  id             Int      @id @default(autoincrement())
  shopId         Int
  websiteId      Int
  parentId       Int?
  name           String   @db.VarChar(120)
  slug           String   @db.VarChar(160)
  description    String?  @db.VarChar(1000)
  imageUrl       String?  @db.VarChar(2048)
  seoTitle       String?  @db.VarChar(70)
  seoDescription String?  @db.VarChar(320)
  sortOrder      Int      @default(0)
  isVisible      Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website  ShopWebsite              @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)
  parent   WebsiteCategory?         @relation("WebsiteCategoryTree", fields: [parentId, websiteId, shopId], references: [id, websiteId, shopId], onDelete: Restrict)
  children WebsiteCategory[]        @relation("WebsiteCategoryTree")
  products WebsiteProductCategory[]

  @@unique([websiteId, slug])
  @@unique([id, websiteId])
  @@unique([id, websiteId, shopId])
  @@unique([id, shopId])
  @@index([shopId, websiteId, parentId, sortOrder])
  @@index([websiteId, isVisible])
}

model WebsiteProductCategory {
  shopId     Int
  productId  Int
  categoryId Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  product  Product         @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  category WebsiteCategory @relation(fields: [categoryId, shopId], references: [id, shopId], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([shopId, categoryId, sortOrder])
}

// Variant-level storefront controls complement the product-level WebsiteListing.
// Price precedence: variant override -> listing override -> ProductVariant.sellingPrice.
// These override fields are intentional presentation overrides, not duplicate source data.
model WebsiteVariantListing {
  id               Int      @id @default(autoincrement())
  shopId           Int
  websiteId        Int
  websiteListingId Int
  productId        Int
  variantId        Int
  isVisible        Boolean  @default(true)
  overridePrice    Decimal? @db.Decimal(19, 4)
  compareAtPrice   Decimal? @db.Decimal(19, 4)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  website ShopWebsite    @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)
  listing WebsiteListing @relation(fields: [websiteListingId, productId, shopId], references: [id, productId, shopId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId, productId, shopId], references: [id, productId, shopId], onDelete: Cascade)
  shop    Shop           @relation(fields: [shopId], references: [id])

  @@unique([websiteListingId, variantId])
  @@index([shopId, websiteId, isVisible, sortOrder])
  @@index([shopId, variantId, isVisible])
}

// Flexible homepage blocks (hero, featured collection, rich text, category grid).
// content is validated by the application according to sectionType.
model WebsiteHomepageSection {
  id          Int       @id @default(autoincrement())
  shopId      Int
  websiteId   Int
  sectionType String    @db.VarChar(50)
  title       String?   @db.VarChar(180)
  content     Json      @default("{}")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime? @db.Timestamptz(6)
  endsAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@index([websiteId, isActive, sortOrder])
  @@index([shopId, startsAt, endsAt])
}

// Historical URL redirects prevent broken links after product/category/page
// slug changes. Redirect loops and destination validity are application checks.
model WebsiteSlugRedirect {
  id         Int      @id @default(autoincrement())
  shopId     Int
  websiteId  Int
  oldPath    String   @db.VarChar(500)
  newPath    String   @db.VarChar(500)
  httpStatus Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([websiteId, oldPath])
  @@index([websiteId, isActive])
}

// -----------------------------------------------------------------------------
// BUSINESS WEBSITE + MARKETPLACE LISTINGS
// Listings are product-level. overridePrice applies to all variants of the product.
// -----------------------------------------------------------------------------

model WebsiteListing {
  id            Int           @id @default(autoincrement())
  shopId        Int
  productId     Int
  status        ListingStatus @default(DRAFT)
  isVisible     Boolean       @default(true)
  overridePrice Decimal?      @db.Decimal(19, 4)
  publishedAt   DateTime?     @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(6)

  shop            Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product         Product                 @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  variantListings WebsiteVariantListing[]

  @@unique([productId, shopId])
  @@unique([id, shopId])
  @@unique([id, productId, shopId])
  @@index([shopId, status, isVisible])
}

model MarketplaceListing {
  id            Int           @id @default(autoincrement())
  shopId        Int
  productId     Int
  status        ListingStatus @default(DRAFT)
  isVisible     Boolean       @default(true)
  overridePrice Decimal?      @db.Decimal(19, 4)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([productId, shopId])
  @@index([status, isVisible, publishedAt])
  @@index([shopId, status])
}

// -----------------------------------------------------------------------------
// MARKETPLACE / WEBSITE ORDERS
// Keep POS Sale and online Order separate; both use the same catalog.
// -----------------------------------------------------------------------------

model Order {
  id             Int          @id @default(autoincrement())
  shopId         Int
  customerId     Int?
  orderNumber    String       @db.VarChar(80)
  channel        SalesChannel
  status         OrderStatus  @default(PENDING)
  customerName   String       @db.VarChar(160)
  customerEmail  String?      @db.VarChar(254)
  customerPhone  String?      @db.VarChar(40)
  currency       String       @db.VarChar(3)
  subtotal       Decimal      @db.Decimal(19, 4)
  discountTotal  Decimal      @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal      @default(0) @db.Decimal(19, 4)
  shippingTotal  Decimal      @default(0) @db.Decimal(19, 4)
  totalAmount    Decimal      @db.Decimal(19, 4)
  idempotencyKey String?      @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  shop             Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer         Customer?            @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  items            OrderItem[]
  payments         Payment[]
  addresses        OrderAddress[]
  shipments        Shipment[]
  reservations     StockReservation[]
  statusHistory    OrderStatusHistory[]
  notes            OrderNote[]
  couponRedemption CouponRedemption?

  @@unique([shopId, orderNumber])
  @@unique([shopId, idempotencyKey])
  @@unique([id, shopId])
  @@index([shopId, status, createdAt])
  @@index([channel, createdAt])
  @@index([shopId, customerId, createdAt])
}

model OrderItem {
  id             Int      @id @default(autoincrement())
  orderId        Int
  shopId         Int
  productId      Int?
  variantId      Int?
  productName    String   @db.VarChar(180)
  variantName    String?  @db.VarChar(180)
  sku            String?  @db.VarChar(80)
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(19, 4)
  unitCost       Decimal? @db.Decimal(19, 4)
  discountAmount Decimal  @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(19, 4)
  totalPrice     Decimal  @db.Decimal(19, 4)

  order         Order           @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  // Tenant + product ownership are enforced by composite FKs. Product snapshots remain readable;
  // archive catalog rows rather than deleting products referenced by historical orders.
  product       Product?        @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId, productId, shopId], references: [id, productId, shopId], onDelete: Restrict)
  shipmentItems ShipmentItem[]

  @@unique([id, orderId, shopId])
  @@index([shopId, orderId])
  @@index([shopId, productId])
  @@index([shopId, variantId])
}

model OrderAddress {
  id         Int         @id @default(autoincrement())
  orderId    Int
  shopId     Int
  type       AddressType
  name       String      @db.VarChar(160)
  phone      String?     @db.VarChar(40)
  line1      String      @db.VarChar(255)
  line2      String?     @db.VarChar(255)
  city       String      @db.VarChar(100)
  region     String?     @db.VarChar(100)
  postalCode String?     @db.VarChar(20)
  country    String      @db.VarChar(2)

  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([orderId, type])
}

model Shipment {
  id             Int            @id @default(autoincrement())
  orderId        Int
  shopId         Int
  carrier        String?        @db.VarChar(80)
  trackingNumber String?        @db.VarChar(120)
  status         ShipmentStatus @default(PENDING)
  shippingCost   Decimal        @default(0) @db.Decimal(19, 4)
  shippedAt      DateTime?      @db.Timestamptz(6)
  deliveredAt    DateTime?      @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)

  order Order          @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Restrict)
  items ShipmentItem[]

  @@unique([id, orderId, shopId])
  @@index([orderId])
  @@index([trackingNumber])
}

// Partial shipments: which order lines (and how many) are in this parcel.
model ShipmentItem {
  id          Int     @id @default(autoincrement())
  shipmentId  Int
  orderId     Int
  shopId      Int
  orderItemId Int
  quantity    Decimal @db.Decimal(14, 3)

  shipment  Shipment  @relation(fields: [shipmentId, orderId, shopId], references: [id, orderId, shopId], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId, orderId, shopId], references: [id, orderId, shopId], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int
  shopId            Int
  provider          String        @db.VarChar(60)
  providerPaymentId String?       @db.VarChar(160)
  amount            Decimal       @db.Decimal(19, 4)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String?       @db.VarChar(120)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order         Order                 @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Restrict)
  refunds       PaymentRefund[]
  webhookEvents PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@unique([shopId, idempotencyKey])
  @@unique([id, shopId])
  @@index([orderId, status])
}

model PaymentRefund {
  id               Int          @id @default(autoincrement())
  paymentId        Int
  shopId           Int
  amount           Decimal      @db.Decimal(19, 4)
  reason           String?      @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @db.VarChar(160)
  idempotencyKey   String?      @db.VarChar(120)
  createdAt        DateTime     @default(now())

  payment Payment @relation(fields: [paymentId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([shopId, idempotencyKey])
  @@index([paymentId])
}

// -----------------------------------------------------------------------------
// AUDIT / SECURITY TELEMETRY
// Append-only by policy: REVOKE UPDATE, DELETE on these tables from the app DB role.
// -----------------------------------------------------------------------------

model AuditLog {
  id          BigInt           @id @default(autoincrement())
  shopId      Int?
  actorUserId Int?
  action      String           @db.VarChar(120)
  entity      String           @db.VarChar(100)
  entityId    String?          @db.VarChar(100)
  severity    SecuritySeverity @default(INFO)
  ipAddress   String?          @db.VarChar(45)
  userAgent   String?          @db.VarChar(512)
  metadata    Json?
  createdAt   DateTime         @default(now())

  shop  Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model SecurityEvent {
  id        BigInt            @id @default(autoincrement())
  userId    Int?
  shopId    Int?
  eventType SecurityEventType
  severity  SecuritySeverity
  ipAddress String?           @db.VarChar(45)
  userAgent String?           @db.VarChar(512)
  details   Json?
  createdAt DateTime          @default(now())

  user User? @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([shopId, createdAt])
  @@index([eventType, severity, createdAt])
}

// =============================================================================
// V5 — TENANT STOREFRONTS (URL: https://bitsshop.com/{Shop.slug})
// One ShopWebsite per Shop. The platform uses one shared frontend and resolves
// the shop from the first URL path segment; never trust a client-supplied shopId.
// =============================================================================

model ShopWebsite {
  id                 Int           @id @default(autoincrement())
  shopId             Int           @unique
  status             WebsiteStatus @default(SETUP)
  displayName        String        @db.VarChar(160)
  tagline            String?       @db.VarChar(240)
  logoUrl            String?       @db.VarChar(2048)
  faviconUrl         String?       @db.VarChar(2048)
  supportEmail       String?       @db.VarChar(254)
  supportPhone       String?       @db.VarChar(40)
  defaultLocale      String        @default("en") @db.VarChar(12)
  enabledLocales     String[]      @default(["en"])
  currency           String        @default("USD") @db.VarChar(3)
  pricesIncludeTax   Boolean       @default(false)
  showOutOfStock     Boolean       @default(false)
  allowGuestCheckout Boolean       @default(true)
  maintenanceMode    Boolean       @default(false)
  publishedAt        DateTime?     @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(6)

  shop             Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  theme            WebsiteTheme?
  categories       WebsiteCategory[]
  homepageSections WebsiteHomepageSection[]
  slugRedirects    WebsiteSlugRedirect[]
  variantListings  WebsiteVariantListing[]
  seo              WebsiteSEO?
  domains          WebsiteDomain[]
  pages            WebsitePage[]
  banners          WebsiteBanner[]
  navigation       WebsiteNavigation[]
  policies         WebsitePolicy[]

  @@unique([id, shopId])
  @@index([status, publishedAt])
}

// The default public URL is bitsshop.com/{Shop.slug}; custom domains are optional.
// Verify DNS/HTTP ownership before setting isVerified=true in trusted server code.
model WebsiteDomain {
  id                    Int       @id @default(autoincrement())
  shopId                Int
  websiteId             Int
  host                  String    @unique @db.VarChar(253)
  isPrimary             Boolean   @default(false)
  isVerified            Boolean   @default(false)
  verificationTokenHash String?   @db.VarChar(128)
  verifiedAt            DateTime? @db.Timestamptz(6)
  sslStatus             String    @default("PENDING") @db.VarChar(30)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@index([shopId, isPrimary])
  @@index([websiteId, isVerified])
}

model WebsiteTheme {
  id             Int      @id @default(autoincrement())
  shopId         Int
  websiteId      Int      @unique
  primaryColor   String   @default("#1F2937") @db.VarChar(7)
  secondaryColor String   @default("#F3F4F6") @db.VarChar(7)
  accentColor    String   @default("#2563EB") @db.VarChar(7)
  textColor      String   @default("#111827") @db.VarChar(7)
  fontFamily     String   @default("system") @db.VarChar(80)
  borderRadius   String   @default("medium") @db.VarChar(20)
  layoutConfig   Json     @default("{}")
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([websiteId, shopId])
  @@unique([id, shopId])
}

model WebsiteSEO {
  id               Int      @id @default(autoincrement())
  shopId           Int
  websiteId        Int      @unique
  title            String?  @db.VarChar(70)
  description      String?  @db.VarChar(320)
  keywords         String[] @default([])
  ogImageUrl       String?  @db.VarChar(2048)
  robotsIndex      Boolean  @default(true)
  robotsFollow     Boolean  @default(true)
  canonicalBaseUrl String?  @db.VarChar(2048)
  structuredData   Json?
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([websiteId, shopId])
  @@unique([id, shopId])
}

model WebsitePage {
  id             Int               @id @default(autoincrement())
  shopId         Int
  websiteId      Int
  slug           String            @db.VarChar(160)
  title          String            @db.VarChar(180)
  excerpt        String?           @db.VarChar(500)
  content        Json
  status         WebsitePageStatus @default(DRAFT)
  seoTitle       String?           @db.VarChar(70)
  seoDescription String?           @db.VarChar(320)
  publishedAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([shopId, slug])
  @@unique([id, shopId])
  @@index([websiteId, status, publishedAt])
}

model WebsiteBanner {
  id             Int                    @id @default(autoincrement())
  shopId         Int
  websiteId      Int
  title          String?                @db.VarChar(160)
  subtitle       String?                @db.VarChar(240)
  imageUrl       String                 @db.VarChar(2048)
  mobileImageUrl String?                @db.VarChar(2048)
  targetUrl      String?                @db.VarChar(2048)
  placement      WebsiteBannerPlacement @default(HOME_HERO)
  sortOrder      Int                    @default(0)
  isActive       Boolean                @default(true)
  startsAt       DateTime?              @db.Timestamptz(6)
  endsAt         DateTime?              @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)

  shop    Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([websiteId, placement, isActive, sortOrder])
  @@index([shopId, startsAt, endsAt])
}

model WebsiteNavigation {
  id        Int      @id @default(autoincrement())
  shopId    Int
  websiteId Int
  name      String   @db.VarChar(80)
  location  String   @default("HEADER") @db.VarChar(30)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  website ShopWebsite             @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)
  items   WebsiteNavigationItem[]

  @@unique([shopId, name, location])
  @@unique([id, shopId])
}

model WebsiteNavigationItem {
  id           Int     @id @default(autoincrement())
  shopId       Int
  navigationId Int
  parentId     Int?
  label        String  @db.VarChar(100)
  url          String? @db.VarChar(2048)
  sortOrder    Int     @default(0)
  isVisible    Boolean @default(true)

  navigation WebsiteNavigation       @relation(fields: [navigationId, shopId], references: [id, shopId], onDelete: Cascade)
  parent     WebsiteNavigationItem?  @relation("NavigationTree", fields: [parentId, navigationId, shopId], references: [id, navigationId, shopId], onDelete: Restrict)
  children   WebsiteNavigationItem[] @relation("NavigationTree")

  @@unique([id, shopId])
  @@unique([id, navigationId, shopId])
  @@index([navigationId, parentId, sortOrder])
}

model WebsiteSocialLink {
  id        Int     @id @default(autoincrement())
  shopId    Int
  platform  String  @db.VarChar(40)
  url       String  @db.VarChar(2048)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, platform])
  @@index([shopId, isActive, sortOrder])
}

model WebsitePolicy {
  id        Int      @id @default(autoincrement())
  shopId    Int
  websiteId Int
  kind      String   @db.VarChar(40) // PRIVACY, TERMS, RETURNS, SHIPPING
  title     String   @db.VarChar(160)
  content   Json
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  website ShopWebsite @relation(fields: [websiteId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([shopId, kind, version])
  @@index([websiteId, kind, isActive])
}

model WebsiteProductMedia {
  id        Int      @id @default(autoincrement())
  shopId    Int
  productId Int
  url       String   @db.VarChar(2048)
  altText   String?  @db.VarChar(240)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([shopId, productId, sortOrder])
  @@index([shopId, isPrimary])
}

// =============================================================================
// V5 — CUSTOMER ACCOUNTS, ADDRESSES, CARTS, WISHLISTS AND REVIEWS
// Customer remains tenant-specific; the same email may exist in different shops.
// =============================================================================

model CustomerAccount {
  id               Int       @id @default(autoincrement())
  shopId           Int
  customerId       Int       @unique
  emailNormalized  String    @db.VarChar(254)
  passwordHash     String?   @db.VarChar(255)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  lockedUntil      DateTime?
  failedLoginCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([customerId, shopId])
  @@unique([shopId, emailNormalized])
  @@unique([id, shopId])
  @@index([shopId, lockedUntil])
}

model CustomerAddress {
  id         Int      @id @default(autoincrement())
  shopId     Int
  customerId Int
  label      String?  @db.VarChar(80)
  name       String   @db.VarChar(160)
  phone      String?  @db.VarChar(40)
  line1      String   @db.VarChar(255)
  line2      String?  @db.VarChar(255)
  city       String   @db.VarChar(100)
  region     String?  @db.VarChar(100)
  postalCode String?  @db.VarChar(20)
  country    String   @db.VarChar(2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@index([shopId, customerId, isDefault])
}

model Cart {
  id             Int        @id @default(autoincrement())
  shopId         Int
  customerId     Int?
  sessionKeyHash String?    @db.VarChar(128)
  status         CartStatus @default(ACTIVE)
  currency       String     @db.VarChar(3)
  expiresAt      DateTime   @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(6)

  shop     Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  items    CartItem[]

  @@unique([id, shopId])
  @@unique([shopId, sessionKeyHash])
  @@index([shopId, status, expiresAt])
  @@index([shopId, customerId, status])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  shopId    Int
  productId Int
  variantId Int
  quantity  Decimal  @db.Decimal(14, 3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId, shopId], references: [id, shopId], onDelete: Cascade)
  product Product        @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId, productId, shopId], references: [id, productId, shopId], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([shopId, productId])
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  shopId     Int
  customerId Int
  name       String   @default("My Wishlist") @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Cascade)
  items    WishlistItem[]

  @@unique([id, shopId])
  @@index([shopId, customerId])
}

model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  shopId     Int
  productId  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  wishlist Wishlist @relation(fields: [wishlistId, shopId], references: [id, shopId], onDelete: Cascade)
  product  Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([shopId, productId])
}

model ProductReview {
  id               Int          @id @default(autoincrement())
  shopId           Int
  productId        Int
  customerId       Int
  rating           Int
  title            String?      @db.VarChar(160)
  body             String?      @db.VarChar(3000)
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  moderatedAt      DateTime?    @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  customer Customer @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([shopId, productId, status, createdAt])
  @@index([shopId, customerId])
}

// =============================================================================
// V5 — COUPONS AND SHIPPING CONFIGURATION
// =============================================================================

model Coupon {
  id               Int          @id @default(autoincrement())
  shopId           Int
  code             String       @db.VarChar(60)
  type             CouponType
  status           CouponStatus @default(DRAFT)
  value            Decimal      @db.Decimal(19, 4)
  minimumSubtotal  Decimal?     @db.Decimal(19, 4)
  maximumDiscount  Decimal?     @db.Decimal(19, 4)
  usageLimit       Int?
  perCustomerLimit Int?
  usageCount       Int          @default(0)
  startsAt         DateTime?    @db.Timestamptz(6)
  endsAt           DateTime?    @db.Timestamptz(6)
  firstOrderOnly   Boolean      @default(false)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)

  shop        Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products    CouponProduct[]
  redemptions CouponRedemption[]

  @@unique([shopId, code])
  @@unique([id, shopId])
  @@index([shopId, status, startsAt, endsAt])
}

model CouponProduct {
  id        Int @id @default(autoincrement())
  shopId    Int
  couponId  Int
  productId Int

  coupon  Coupon  @relation(fields: [couponId, shopId], references: [id, shopId], onDelete: Cascade)
  product Product @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([shopId, productId])
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  shopId         Int
  couponId       Int
  customerId     Int?
  orderId        Int      @unique
  codeSnapshot   String   @db.VarChar(60)
  discountAmount Decimal  @db.Decimal(19, 4)
  redeemedAt     DateTime @default(now()) @db.Timestamptz(6)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  coupon   Coupon    @relation(fields: [couponId, shopId], references: [id, shopId], onDelete: Restrict)
  customer Customer? @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: Restrict)
  order    Order     @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Restrict)

  @@unique([orderId, shopId])
  @@index([shopId, couponId, redeemedAt])
  @@index([shopId, customerId, redeemedAt])
}

model ShippingZone {
  id             Int      @id @default(autoincrement())
  shopId         Int
  name           String   @db.VarChar(120)
  countryCodes   String[] @default([])
  regions        String[] @default([])
  postalPatterns String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  shop    Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  methods ShippingMethod[]

  @@unique([shopId, name])
  @@unique([id, shopId])
  @@index([shopId, isActive])
}

model ShippingMethod {
  id              Int              @id @default(autoincrement())
  shopId          Int
  zoneId          Int
  name            String           @db.VarChar(120)
  description     String?          @db.VarChar(500)
  rateType        ShippingRateType @default(FLAT)
  basePrice       Decimal          @default(0) @db.Decimal(19, 4)
  freeAbove       Decimal?         @db.Decimal(19, 4)
  minDeliveryDays Int?
  maxDeliveryDays Int?
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  shop Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  zone ShippingZone @relation(fields: [zoneId, shopId], references: [id, shopId], onDelete: Cascade)

  @@unique([id, shopId])
  @@unique([zoneId, name])
  @@index([shopId, isActive, sortOrder])
}

// =============================================================================
// V5 — ORDER AUDIT TRAIL AND PAYMENT WEBHOOK IDEMPOTENCY
// =============================================================================

model OrderStatusHistory {
  id         BigInt                @id @default(autoincrement())
  shopId     Int
  orderId    Int
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderHistoryActorType @default(SYSTEM)
  actorRef   String?               @db.VarChar(120)
  note       String?               @db.VarChar(500)
  metadata   Json?
  createdAt  DateTime              @default(now()) @db.Timestamptz(6)

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([shopId, orderId, createdAt])
  @@index([shopId, toStatus, createdAt])
}

model PaymentWebhookEvent {
  id              BigInt               @id @default(autoincrement())
  shopId          Int
  paymentId       Int?
  provider        String               @db.VarChar(60)
  providerEventId String               @db.VarChar(200)
  eventType       String               @db.VarChar(120)
  payloadHash     String               @db.VarChar(128)
  status          WebhookProcessStatus @default(RECEIVED)
  attemptCount    Int                  @default(0)
  receivedAt      DateTime             @default(now())
  processedAt     DateTime?
  lastError       String?              @db.VarChar(1000)

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([shopId, status, receivedAt])
  @@index([paymentId])
}

// Order notes are separate from status history so internal/customer-visible
// operational notes do not overload lifecycle events.
model OrderNote {
  id         Int      @id @default(autoincrement())
  shopId     Int
  orderId    Int
  body       String   @db.VarChar(3000)
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)

  @@index([shopId, orderId, createdAt])
}
