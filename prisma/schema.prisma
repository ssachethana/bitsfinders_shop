// Payment state is a derived projection; reconcile from allocations and returns transactionally.
enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// v4: Customer receivable ledger. Amount sign (customer perspective, +ve = customer owes more):
//   CREDIT_SALE        +  unpaid part of a sale put on account
//   PAYMENT            -  customer paid down the balance
//   RETURN_CREDIT      -  refund of a (credit) sale given as balance reduction / store credit
//   STORE_CREDIT_USED  +  customer spent store credit (balance moves back toward 0)
//   WRITE_OFF          -  bad debt written off
//   ADJUSTMENT         +/- manual correction (needs a note)
//   OPENING_BALANCE    +/- migrated opening balance
enum CustomerCreditEntryType {
  CREDIT_SALE
  PAYMENT
  RETURN_CREDIT
  STORE_CREDIT_USED
  WRITE_OFF
  ADJUSTMENT
  OPENING_BALANCE
}

// v4: Supplier payable ledger. Amount sign (+ve = shop owes supplier more):
//   PURCHASE          +  goods received on credit (Purchase.totalAmount)
//   PAYMENT           -  SupplierPayment
//   PURCHASE_RETURN   -  goods returned (PurchaseReturn.totalAmount)
//   ADJUSTMENT        +/-
//   OPENING_BALANCE   +/-
enum SupplierLedgerEntryType {
  PURCHASE
  PAYMENT
  PURCHASE_RETURN
  ADJUSTMENT
  OPENING_BALANCE
}

